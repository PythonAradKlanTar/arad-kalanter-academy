const $=s=>document.querySelector(s);
let currentConversation=null;
async function api(url,options={}){
  const res=await fetch('/api'+url,{credentials:'same-origin',...options});
  const type=res.headers.get('content-type')||'';
  if(!res.ok){let data={};try{data=type.includes('json')?await res.json():{error:await res.text()}}catch{};throw new Error(data.error||'درخواست ناموفق بود.')}
  return type.includes('application/json')?res.json():res;
}
function message(text,role='assistant'){
  const div=document.createElement('div');div.className='bubble '+role;div.textContent=text;$('#messages').append(div);$('#messages').scrollTop=$('#messages').scrollHeight;
}
function status(text){$('#authMessage').textContent=text}
async function refreshMe(){
  const data=await api('/auth/me');$('#authPanel').classList.add('hidden');$('#appPanel').classList.remove('hidden');
  $('#userLabel').textContent=data.user.email+' · '+data.user.role;$('#logoutBtn').classList.remove('hidden');
  $('#membershipStatus').textContent=data.echo_plus?'ECHO PLUS فعال است':'ECHO PLUS فعال نیست';
  loadConversations();
}
async function loadConversations(){
  const data=await api('/conversations');$('#conversationList').replaceChildren();
  data.conversations.forEach(c=>{const b=document.createElement('button');b.className='conversation'+(String(c.id)===String(currentConversation)?' active':'');b.textContent=c.title;b.onclick=()=>openConversation(c.id);$('#conversationList').append(b)});
}
async function openConversation(id){
  currentConversation=id;const d=await api(`/conversations/${id}/messages`);$('#messages').replaceChildren();
  d.messages.forEach(m=>message(m.content,m.role));loadConversations();
}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));
  $('#userRequest').classList.toggle('hidden',b.dataset.tab!=='user');
  $('#userVerify').classList.add('hidden');$('#ownerLogin').classList.toggle('hidden',b.dataset.tab!=='owner');status('');
});
$('#userRequest').onsubmit=async e=>{
  e.preventDefault();try{const email=$('#email').value;await api('/auth/request-code',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email})});$('#userVerify').classList.remove('hidden');status('کد ارسال شد؛ صندوق ورودی و پوشه هرزنامه را بررسی کنید.')}catch(err){status(err.message)}
};
$('#userVerify').onsubmit=async e=>{
  e.preventDefault();try{await api('/auth/verify-code',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:$('#email').value,code:$('#otp').value})});await refreshMe()}catch(err){status(err.message)}
};
$('#ownerLogin').onsubmit=async e=>{
  e.preventDefault();try{await api('/auth/owner-login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:$('#ownerEmail').value,password:$('#ownerPassword').value})});await refreshMe()}catch(err){status(err.message)}
};
$('#logoutBtn').onclick=async()=>{await api('/auth/logout',{method:'POST'});location.reload()};
$('#newChat').onclick=async()=>{const d=await api('/conversations',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})});currentConversation=d.conversation.id;$('#messages').replaceChildren();loadConversations()};
$('#chatForm').onsubmit=async e=>{
  e.preventDefault();const text=$('#message').value.trim();if(!text)return;$('#message').value='';message(text,'user');
  try{const d=await api('/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text,conversationId:currentConversation})});currentConversation=d.conversationId;message(d.reply);loadConversations()}catch(err){message(err.message)}
};
$('#fileForm').onsubmit=async e=>{
  e.preventDefault();const file=$('#file').files[0];if(!file)return;const fd=new FormData();fd.append('file',file);fd.append('question',$('#fileQuestion').value);
  try{const d=await api('/files/analyze',{method:'POST',body:fd});message('تحلیل فایل:\n'+d.reply)}catch(err){message(err.message)}
};
$('#searchForm').onsubmit=async e=>{
  e.preventDefault();try{const d=await api('/search',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:$('#searchQuery').value})});$('#toolOutput').replaceChildren();
  d.results.forEach(r=>{const p=document.createElement('p');const a=document.createElement('a');a.href=r.url;a.target='_blank';a.rel='noopener';a.textContent=r.title;a.style.color='#9eabff';p.append(a,document.createTextNode(' — '+r.content));$('#toolOutput').append(p)})}catch(err){message(err.message)}
};
$('#imageForm').onsubmit=async e=>{
  e.preventDefault();try{const d=await api('/images/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:$('#imagePrompt').value})});showImage(d.image)}catch(err){message(err.message)}
};
$('#editForm').onsubmit=async e=>{
  e.preventDefault();const file=$('#editImage').files[0];if(!file){message('ابتدا تصویر را انتخاب کن.');return}const fd=new FormData();fd.append('image',file);fd.append('prompt',$('#editPrompt').value);
  try{const d=await api('/images/edit',{method:'POST',body:fd});showImage(d.image)}catch(err){message(err.message)}
};
function showImage(data){
  $('#toolOutput').replaceChildren();if(data?.url){const img=document.createElement('img');img.src=data.url;$('#toolOutput').append(img)}
  else if(data?.b64_json){const img=document.createElement('img');img.src='data:image/png;base64,'+data.b64_json;$('#toolOutput').append(img)}
  else $('#toolOutput').textContent='پاسخ تصویر دریافت شد، اما نشانی قابل نمایش برنگشت.';
}
refreshMe().catch(()=>{});

