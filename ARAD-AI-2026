const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const rateLimit = require('express-rate-limit');
const config = require('../config');
const db = require('../db');
const { hashOtp, cleanEmail, isEmail, safeEqual } = require('../utils');
const { sendLoginCode } = require('../services/mailer');
const { requireAuth } = require('../middleware/auth');

const codeLimiter = rateLimit({ windowMs: 15 * 60 * 1000, limit: 5, standardHeaders: true, legacyHeaders: false });
function issueSession(res, user) {
  const token = jwt.sign({ sub: String(user.id), role: user.role }, config.jwtSecret, { expiresIn: '7d' });
  res.cookie('arad_token', token, {
    httpOnly: true, secure: config.cookieSecure, sameSite: 'lax',
    maxAge: 7 * 24 * 60 * 60 * 1000, path: '/'
  });
  return token;
}
router.post('/request-code', codeLimiter, async (req, res, next) => {
  try {
    const email = cleanEmail(req.body.email);
    if (!isEmail(email)) return res.status(400).json({ error: 'ایمیل معتبر وارد کنید.' });
    const code = String(Math.floor(100000 + Math.random() * 900000));
    await db.query(
      `INSERT INTO login_codes(email,code_hash,expires_at)
       VALUES($1,$2,NOW()+INTERVAL '10 minutes')`,
      [email, hashOtp(code)]
    );
    await sendLoginCode(email, code);
    res.json({ ok: true, message: 'کد ورود به ایمیل شما ارسال شد.' });
  } catch (err) { next(err); }
});
router.post('/verify-code', codeLimiter, async (req, res, next) => {
  const client = await db.getClient();
  try {
    const email = cleanEmail(req.body.email);
    const code = String(req.body.code || '').trim();
    if (!isEmail(email) || !/^\d{6}$/.test(code)) return res.status(400).json({ error: 'ایمیل یا کد نامعتبر است.' });
    await client.query('BEGIN');
    const found = await client.query(
      `SELECT * FROM login_codes WHERE email=$1 AND consumed_at IS NULL
       ORDER BY created_at DESC LIMIT 1 FOR UPDATE`, [email]
    );
    const row = found.rows[0];
    if (!row || new Date(row.expires_at) < new Date() || row.attempts >= 5 || !safeEqual(row.code_hash, hashOtp(code))) {
      if (row) await client.query('UPDATE login_codes SET attempts=attempts+1 WHERE id=$1', [row.id]);
      await client.query('COMMIT');
      return res.status(400).json({ error: 'کد اشتباه یا منقضی شده است.' });
    }
    await client.query('UPDATE login_codes SET consumed_at=NOW() WHERE id=$1', [row.id]);
    let userResult = await client.query(
      `INSERT INTO users(email) VALUES($1)
       ON CONFLICT(email) DO UPDATE SET last_login_at=NOW()
       RETURNING id,email,display_name,role,status`, [email]
    );
    const user = userResult.rows[0];
    if (user.status !== 'active' || user.role === 'owner') {
      await client.query('ROLLBACK');
      return res.status(403).json({ error: 'برای این حساب از روش ورود مالک استفاده کنید یا با پشتیبانی تماس بگیرید.' });
    }
    await client.query('COMMIT');
    issueSession(res, user);
    res.json({ ok: true, user });
  } catch (err) { await client.query('ROLLBACK'); next(err); }
  finally { client.release(); }
});
