const OpenAI = require('openai');
let client;
function getClient() {
  if (!process.env.AI_API_KEY) throw new Error('AI_API_KEY تنظیم نشده است.');
  if (!client) client = new OpenAI({
    apiKey: process.env.AI_API_KEY,
    baseURL: process.env.AI_BASE_URL || 'https://api.openai.com/v1'
  });
  return client;
}
async function chat(messages) {
  const result = await getClient().chat.completions.create({
    model: process.env.AI_CHAT_MODEL || 'gpt-4o-mini',
    messages,
    temperature: 0.7
  });
  return { text: result.choices?.[0]?.message?.content || '', model: result.model };
}
async function generateImage(prompt) {
  const result = await getClient().images.generate({
    model: process.env.AI_IMAGE_MODEL || 'gpt-image-1',
    prompt,
    size: '1024x1024'
  });
  return result.data?.[0] || null;
}
async function editImage(buffer, mimeType, prompt) {
  const result = await getClient().images.edit({
    model: process.env.AI_IMAGE_MODEL || 'gpt-image-1',
    image: new File([buffer], 'source-image', { type: mimeType }),
    prompt,
    size: '1024x1024'
  });
  return result.data?.[0] || null;
}
async function transcribe(buffer, filename) {
  return getClient().audio.transcriptions.create({
    file: new File([buffer], filename),
    model: process.env.AI_STT_MODEL || 'whisper-1'
  });
}
async function speak(text) {
  const result = await getClient().audio.speech.create({
    model: process.env.AI_TTS_MODEL || 'tts-1',
    voice: 'alloy',
    input: text
  });
  return Buffer.from(await result.arrayBuffer());
}
module.exports = { chat, generateImage, editImage, transcribe, speak };

