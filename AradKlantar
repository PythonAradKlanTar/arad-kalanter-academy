<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#070b18">
<title>کدنویسی و هوش مصنوعی | ARAD ACADEMY</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
:root{
 --bg:#070b18;
 --panel:rgba(17,27,49,.82);
 --border:rgba(56,189,248,.2);
 --blue:#38bdf8;
 --purple:#a855f7;
 --green:#2ef5b0;
 --white:#f1f5ff;
 --muted:#9baac7;
 --danger:#fb5275;
}

*{
 margin:0;
 padding:0;
 box-sizing:border-box;
}

html{scroll-behavior:smooth}

body{
 background:var(--bg);
 color:var(--white);
 font-family:'Vazirmatn',Tahoma,sans-serif;
 min-height:100vh;
 overflow-x:hidden;
}

button,input,textarea{font-family:inherit}
button{cursor:pointer}

#background{
 position:fixed;
 inset:0;
 z-index:-3;
 background:
 radial-gradient(ellipse at 15% 20%,rgba(56,189,248,.16),transparent 35%),
 radial-gradient(ellipse at 85% 75%,rgba(168,85,247,.17),transparent 35%),
 #070b18;
}

.grid-bg{
 position:fixed;
 inset:0;
 z-index:-2;
 pointer-events:none;
 opacity:.12;
 background-image:
 linear-gradient(rgba(56,189,248,.2) 1px,transparent 1px),
 linear-gradient(90deg,rgba(56,189,248,.2) 1px,transparent 1px);
 background-size:45px 45px;
 mask-image:linear-gradient(to bottom,black,transparent);
}

.glow{
 position:fixed;
 width:300px;
 height:300px;
 border-radius:50%;
 filter:blur(100px);
 opacity:.2;
 z-index:-1;
 pointer-events:none;
 animation:glowMove 9s infinite alternate;
}

.glow.one{
 background:#168aff;
 top:10%;
 left:-150px;
}

.glow.two{
 background:#a855f7;
 bottom:5%;
 right:-150px;
 animation-delay:2s;
}

@keyframes glowMove{
 to{transform:translate(80px,70px)}
}

header{
 position:sticky;
 top:0;
 z-index:100;
 background:rgba(7,11,24,.9);
 backdrop-filter:blur(20px);
 border-bottom:1px solid var(--border);
}

.navbar{
 max-width:1250px;
 margin:auto;
 padding:14px 22px;
 min-height:76px;
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:15px;
}

.logo{
 font-size:19px;
 font-weight:900;
 color:white;
 white-space:nowrap;
}

.logo span{
 color:var(--blue);
}

.nav-links{
 display:flex;
 align-items:center;
 gap:8px;
 flex-wrap:wrap;
}

.nav-links button{
 background:transparent;
 border:1px solid transparent;
 color:var(--muted);
 padding:9px 13px;
 border-radius:12px;
 font-size:13px;
 transition:.3s;
}

.nav-links button:hover,
.nav-links button.active{
 color:var(--blue);
 border-color:var(--border);
 background:rgba(56,189,248,.08);
}

.menu-toggle{
 display:none;
 border:1px solid var(--border);
 color:white;
 background:var(--panel);
 padding:9px 13px;
 border-radius:10px;
 font-size:20px;
}

.container{
 max-width:1200px;
 width:92%;
 margin:auto;
}

.page{
 display:none;
 animation:pageIn .4s ease;
}

.page.active{display:block}

@keyframes pageIn{
 from{opacity:0;transform:translateY(12px)}
 to{opacity:1;transform:translateY(0)}
}

.hero{
 min-height:610px;
 display:grid;
 grid-template-columns:1.1fr .9fr;
 align-items:center;
 gap:40px;
 padding:65px 0;
}

.badge{
 display:inline-block;
 padding:7px 15px;
 border:1px solid rgba(56,189,248,.3);
 background:rgba(56,189,248,.08);
 color:var(--blue);
 border-radius:30px;
 font-size:12px;
 margin-bottom:20px;
}

.hero h1{
 font-size:clamp(32px,5vw,58px);
 line-height:1.6;
 font-weight:900;
}

.gradient{
 background:linear-gradient(90deg,#38bdf8,#a855f7,#2ef5b0);
 background-clip:text;
 -webkit-background-clip:text;
 color:transparent;
}

.hero p{
 color:var(--muted);
 line-height:2.3;
 margin:18px 0;
 font-size:15px;
}

.btn{
 border:none;
 border-radius:12px;
 padding:12px 21px;
 background:linear-gradient(110deg,#168aff,#8b5cf6);
 color:white;
 font-size:14px;
 font-weight:700;
 box-shadow:0 5px 25px rgba(56,189,248,.18);
 transition:.3s;
}

.btn:hover{
 transform:translateY(-3px);
 box-shadow:0 8px 30px rgba(56,189,248,.35);
}

.btn.secondary{
 background:rgba(255,255,255,.05);
 border:1px solid var(--border);
 box-shadow:none;
}

.hero-visual{
 background:linear-gradient(145deg,rgba(30,50,85,.75),rgba(12,19,37,.9));
 border:1px solid var(--border);
 border-radius:25px;
 padding:35px;
 box-shadow:0 0 50px rgba(56,189,248,.1);
 position:relative;
 overflow:hidden;
}

.hero-visual::before{
 content:"";
 position:absolute;
 width:200px;
 height:200px;
 background:var(--purple);
 filter:blur(100px);
 opacity:.2;
 top:-70px;
 left:-60px;
}

.terminal{
 direction:ltr;
 text-align:left;
 padding:24px;
 margin-top:25px;
 background:#050a15;
 border:1px solid rgba(56,189,248,.2);
 border-radius:16px;
 font-family:monospace;
 font-size:14px;
 line-height:2.2;
 color:#b8c9e9;
 overflow-wrap:anywhere;
}

.terminal .keyword{color:#c084fc}
.terminal .string{color:#2ef5b0}
.terminal .function{color:#38bdf8}

section{padding:45px 0}

.section-title{
 text-align:center;
 margin-bottom:30px;
}

.section-title h2{
 font-size:28px;
 margin-bottom:10px;
}

.section-title p{
 color:var(--muted);
 font-size:14px;
}

.grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:20px;
}

.card,.panel,.stat{
 background:var(--panel);
 border:1px solid var(--border);
 border-radius:20px;
 padding:24px;
 backdrop-filter:blur(14px);
 transition:.3s;
}

.card:hover{
 transform:translateY(-6px);
 border-color:rgba(56,189,248,.55);
 box-shadow:0 10px 35px rgba(56,189,248,.1);
}

.card-icon{
 font-size:35px;
 margin-bottom:15px;
}

.card h3{
 font-size:18px;
 margin-bottom:10px;
}

.card p{
 color:var(--muted);
 line-height:2;
 font-size:13px;
}

.stat{
 text-align:center;
}

.stat strong{
 display:block;
 color:var(--blue);
 font-size:30px;
 margin-bottom:8px;
}

.search{
 width:100%;
 padding:15px;
 background:#101a30;
 border:1px solid var(--border);
 color:white;
 border-radius:12px;
 outline:none;
 margin-bottom:25px;
}

.search:focus{
 border-color:var(--blue);
 box-shadow:0 0 15px rgba(56,189,248,.15);
}

.progress{
 height:8px;
 background:#202c43;
 border-radius:20px;
 overflow:hidden;
 margin:15px 0;
}

.progress span{
 display:block;
 height:100%;
 background:linear-gradient(90deg,var(--blue),var(--purple));
 border-radius:20px;
}

.notice{
 color:var(--muted);
 font-size:12px;
 margin-top:15px;
}

footer{
 text-align:center;
 padding:40px 20px;
 margin-top:60px;
 border-top:1px solid var(--border);
 color:var(--muted);
 line-height:2.4;
}

footer h3{
 font-size:22px;
}

@media(max-width:850px){
