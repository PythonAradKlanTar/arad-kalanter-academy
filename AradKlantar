          <option value="">انتخاب دوره</option>
        </select>

        <select id="aradReviewRating" required>
          <option value="">انتخاب امتیاز</option>
          <option value="5">⭐⭐⭐⭐⭐ عالی</option>
          <option value="4">⭐⭐⭐⭐ خیلی خوب</option>
          <option value="3">⭐⭐⭐ خوب</option>
          <option value="2">⭐⭐ متوسط</option>
          <option value="1">⭐ نیازمند بهبود</option>
        </select>

        <textarea
          id="aradReviewText"
          maxlength="1500"
          placeholder="نظر خودت درباره این دوره را بنویس..."
          required
        ></textarea>

        <button type="submit">
          🚀 ثبت نظر و امتیاز
        </button>

      </form>

      <p class="review-hint">
        فقط کاربران واردشده می‌توانند نظر ثبت کنند.
        هر دانش‌آموز برای هر دوره یک نظر دارد و می‌تواند آن را ویرایش کند.
      </p>

    </div>

    <!-- COURSE REVIEW LIST -->

    <div class="review-box">

      <h2>📚 نظرات دانش‌آموزان</h2>

      <select id="aradReviewFilter">
        <option value="">همه دوره‌ها</option>
      </select>

      <div class="review-rating" id="aradAverageRating">
        ۰.۰ / ۵
      </div>

      <p id="aradReviewCount"
         style="text-align:center;color:#9baac7">
        تعداد نظرات: ۰
      </p>

      <div id="aradReviewList"></div>

    </div>

    <!-- GLASS CERTIFICATE SHOWCASE -->

    <div class="certificate-glass">

      <div style="text-align:center">
        <span style="font-size:38px">🏆</span>

        <h2>
          سامانه هوشمند گواهی‌نامه ARAD
        </h2>

        <p class="certificate-subtitle">
          پس از تکمیل دوره، دستاوردهای آموزشی خود را
          دریافت و اصالت مدرک خود را بررسی کن.
        </p>
      </div>

      <div class="certificate-grid">

        <div class="certificate-feature">
          <span>🎓</span>
          <div>
            <strong>۱. صدور گواهی</strong>
            صدور گواهی برای دانش‌آموزی که تمام درس‌های دوره را گذرانده باشد.
          </div>
        </div>

        <div class="certificate-feature">
          <span>🔐</span>
          <div>
            <strong>۲. شناسه اختصاصی</strong>
            اختصاص یک شناسه منحصربه‌فرد برای هر مدرک.
          </div>
        </div>

        <div class="certificate-feature">
          <span>🖨️</span>
          <div>
            <strong>۳. چاپ مدرک</strong>
            امکان دریافت نسخه قابل چاپ گواهی‌نامه.
          </div>
        </div>

        <div class="certificate-feature">
          <span>📂</span>
          <div>
            <strong>۴. مشاهده مدارک</strong>
            دسترسی دانش‌آموز به فهرست مدارک صادرشده خودش.
          </div>
        </div>

        <div class="certificate-feature">
          <span>🔍</span>
          <div>
            <strong>۵. استعلام اعتبار</strong>
            بررسی اعتبار مدرک با استفاده از کد اختصاصی.
          </div>
        </div>

        <div class="certificate-feature">
          <span>🛡️</span>
          <div>
            <strong>۶. ابطال مدرک</strong>
            امکان ابطال گواهی‌نامه توسط مدیر آکادمی.
          </div>
        </div>

      </div>

      <div class="certificate-link">
        <button type="button" id="aradOpenCertificateV22">
          🏆 ورود به سامانه گواهی‌نامه‌ها
        </button>
      </div>

    </div>

    <!-- ADMIN REVIEW MANAGEMENT -->

    <div class="review-box" id="aradReviewAdmin" hidden>

      <h2>👑 مدیریت نظرات</h2>

      <p class="review-hint">
        مدیر می‌تواند نظرات نامناسب را حذف کند.
      </p>

      <div id="aradAdminReviewList"></div>

    </div>

    <p class="review-hint">
      نسخه آزمایشی: نظرات در حافظه مرورگر ذخیره می‌شوند.
      برای انتشار عمومی و اشتراک نظرات بین کاربران مختلف،
      اتصال به بک‌اند و پایگاه داده مرکزی ضروری است.
    </p>

  `;

  (document.querySelector("main") || document.body)
    .appendChild(section);

  // COURSE OPTIONS

  function renderCourses() {
    const courses = getCourses();

    $("aradReviewCourse").innerHTML =
      '<option value="">انتخاب دوره</option>' +
      courses.map(course => `
        <option value="${safe(course.id)}">
          ${safe(course.name)}
        </option>
      `).join("");

    $("aradReviewFilter").innerHTML =
      '<option value="">همه دوره‌ها</option>' +
      courses.map(course => `
        <option value="${safe(course.id)}">
          ${safe(course.name)}
        </option>
      `).join("");
  }

  // STUDENT REVIEWS

  function renderReviews() {
    const data = getData();
    const filter = $("aradReviewFilter").value;

    const reviews = data.reviews.filter(review =>
      !filter || review.courseId === filter
    );

    const average = reviews.length
      ? reviews.reduce((sum, item) =>
          sum + Number(item.rating), 0) / reviews.length
      : 0;

    $("aradAverageRating").textContent =
      average.toFixed(1) + " / ۵";

    $("aradReviewCount").textContent =
      "تعداد نظرات: " + reviews.length;

    const list = $("aradReviewList");

    list.innerHTML = reviews.length
      ? [...reviews].reverse().map(review => `
          <article class="review-card">

            <h3>${safe(review.courseName)}</h3>

            <div class="review-stars">
              ${"★".repeat(review.rating)}
              ${"☆".repeat(5 - review.rating)}
            </div>

            <p>${safe(review.text)}</p>

            <p class="review-meta">
              👤 ${safe(review.userName)}
              |
              ${new Date(review.createdAt).toLocaleDateString("fa-IR")}
            </p>

            ${getUser() && getUser().id === review.userId ? `
              <small style="color:#4ade80">
                نظر ثبت‌شده توسط شما
              </small>
            ` : ""}

          </article>
        `).join("")
      : "<p>هنوز نظری برای این دوره ثبت نشده است.</p>";

    renderAdminReviews();
  }

  // ADMIN REVIEW MANAGEMENT

  function renderAdminReviews() {
    const allowed = isAdmin();

    $("aradReviewAdmin").hidden = !allowed;

    if (!allowed) return;

    const reviews = getData().reviews;

    $("aradAdminReviewList").innerHTML =
      reviews.length
        ? [...reviews].reverse().map(review => `
          <div class="review-card">

            <h3>${safe(review.courseName)}</h3>

            <p>دانش‌آموز: ${safe(review.userName)}</p>

            <p class="review-stars">
              ${"★".repeat(review.rating)}
            </p>

            <p>${safe(review.text)}</p>

            <button
              class="review-danger"
              data-delete-review="${safe(review.id)}"
            >
              🗑 حذف نظر
            </button>

          </div>
        `).join("")
        : "<p>نظری ثبت نشده است.</p>";
  }

  // SUBMIT REVIEW

  $("aradReviewForm").addEventListener("submit", event => {
    event.preventDefault();

    const user = getUser();

    if (!user) {
      alert("ابتدا وارد حساب دانش‌آموزی شو.");
      return;
    }

    const courseId = $("aradReviewCourse").value;

    const rating = Number(
      $("aradReviewRating").value
    );

    const text = $("aradReviewText").value.trim();

    const course = getCourses().find(
      item => item.id === courseId
    );

    if (
      !course ||
      !Number.isInteger(rating) ||
      rating < 1 ||
      rating > 5 ||
      !text
    ) {
      alert("اطلاعات نظر و امتیاز را بررسی کن.");
      return;
    }

    const data = getData();

    const existing = data.reviews.find(
      review =>
        review.courseId === courseId &&
        review.userId === user.id
    );

    if (existing) {
      existing.rating = rating;
      existing.text = text;
      existing.updatedAt = new Date().toISOString();

      alert("نظر قبلی شما به‌روزرسانی شد.");
    } else {
      data.reviews.push({
        id: "REVIEW-" + Date.now() + "-" +
          Math.random().toString(36).slice(2, 7),

        courseId,
        courseName: course.name,
        userId: user.id,
        userName: user.name,
        rating,
        text,

        createdAt: new Date().toISOString()
      });

      alert("نظر شما با موفقیت ثبت شد. ⭐");
    }

    saveData(data);

    $("aradReviewText").value = "";
    $("aradReviewRating").value = "";

    renderReviews();
  });

  // FILTER REVIEWS

  $("aradReviewFilter").addEventListener(
    "change",
    renderReviews
  );

  // ADMIN DELETE REVIEW

  section.addEventListener("click", event => {
    const button = event.target.closest("[data-delete-review]");

    if (!button) return;

    if (!isAdmin()) return;

    if (!confirm("این نظر حذف شود؟")) return;

    const data = getData();

    data.reviews = data.reviews.filter(
      item => item.id !== button.dataset.deleteReview
    );

    saveData(data);
    renderReviews();

    alert("نظر حذف شد.");
  });

  // OPEN PART 20 CERTIFICATE SYSTEM

  $("aradOpenCertificateV22").addEventListener(
    "click",
    () => {
      const button = document.getElementById(
        "aradCertificateNav"
      );

      if (typeof window.showPage === "function") {
        window.showPage("aradCertificatesV20", button || null);
      } else {
        const certificate = document.getElementById(
          "aradCertificatesV20"
        );

        if (certificate) {
          certificate.classList.add("active");
          certificate.scrollIntoView({ behavior: "smooth" });
        } else {
          alert("ابتدا بخش ۲۰ را به فایل سایت اضافه کن.");
        }
      }

      if (typeof window.aradCertificateRefresh === "function") {
        window.aradCertificateRefresh();
      }
    }
  );

  // NAVIGATION

  const nav = $("navLinks");

  if (nav && !$("aradReviewsNavV22")) {
    const button = document.createElement("button");

    button.id = "aradReviewsNavV22";
    button.type = "button";
    button.textContent = "نظرات ⭐";

    button.addEventListener("click", () => {
      if (typeof window.showPage === "function") {
        window.showPage("aradReviewsV22", button);
      } else {
        section.classList.add("active");
      }

      renderReviews();
    });

    nav.appendChild(button);
  }

  window.aradReviewsRefresh = renderReviews;

  renderCourses();
  renderReviews();

  console.log("ARAD PART 22 READY");

})();
</script>

