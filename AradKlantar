    const id = button.dataset.review;
    const scoreValue = $("teacherScore_" + id).value;
    const feedback = $("teacherFeedback_" + id).value.trim();

    const score = scoreValue === "" ? null : Number(scoreValue);

    if (score !== null &&
        (!Number.isInteger(score) || score < 0 || score > 100)) {
      alert("نمره باید بین صفر و ۱۰۰ باشد.");
      return;
    }

    const data = read(ASSIGN_KEY, {});
    if (!Array.isArray(data.submissions)) return;

    const item = data.submissions.find(x => x.id === id);
    if (!item) return;

    item.score = score;
    item.feedback = feedback;
    item.status = "بررسی شد";
    item.reviewedAt = new Date().toISOString();

    write(ASSIGN_KEY, data);

    render();

    if (typeof window.aradAssignmentsRefresh === "function") {
      window.aradAssignmentsRefresh();
    }

    alert("بررسی پروژه ثبت شد.");
  });

