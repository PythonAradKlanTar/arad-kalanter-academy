                <pre>${escapeHTML(item.code)}</pre>
              </details>
            ` : ""}

            <p class="assignment-status">
              وضعیت فعلی: ${escapeHTML(item.status)}
            </p>

            <input
              type="number"
              min="0"
              max="100"
              placeholder="نمره از ۱۰۰ (اختیاری)"
              id="aradScore_${escapeHTML(item.id)}"
              value="${item.score ?? ""}"
            >

            <textarea
              id="aradFeedback_${escapeHTML(item.id)}"
              placeholder="بازخورد و توضیحات مدیر"
            >${escapeHTML(item.feedback)}</textarea>

            <button data-review="${escapeHTML(item.id)}">
              ✅ ثبت بررسی و نمره
            </button>

