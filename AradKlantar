  background: linear-gradient(90deg,#06b6d4,#8b5cf6);
}
</style>

<script>
/* ==================================
   ARAD EXAM ENGINE
================================== */

let aradExamState = null;

function aradExamDB() {
  return JSON.parse(
    localStorage.getItem("arad_academy_v2") || "{}"
  );
}

function aradExamSave(db) {
  localStorage.setItem(
    "arad_academy_v2",
    JSON.stringify(db)
  );
}

function aradLoadExamCourses() {
  const db = aradExamDB();

  const select = document.getElementById(
    "arad-exam-course"
  );

  if (!select) return;

  select.innerHTML =
    '<option value="">انتخاب دوره</option>' +
    (db.courses || []).map(c => `
      <option value="${escapeHTML(c.id)}">
        ${escapeHTML(c.name)}
      </option>
    `).join("");
}

function aradStartExam() {
  const db = aradExamDB();

  if (!db.current) {
    alert("ابتدا وارد حساب دانش‌آموزی شو.");
    return;
  }

  const id = document.getElementById(
    "arad-exam-course"
  ).value;

  const course = (db.courses || []).find(
    c => c.id === id
  );

  if (!course) {
    alert("یک دوره انتخاب کن.");
    return;
  }

  if (!course.quiz || course.quiz.length === 0) {
    alert("برای این دوره هنوز آزمونی تعریف نشده است.");
    return;
  }

  aradExamState = {
    courseId: id,
    courseName: course.name,
    questions: course.quiz,
    current: 0,
    answers: []
  };

  aradShowExamQuestion();
}

function aradShowExamQuestion() {
  const state = aradExamState;

  if (!state) return;

  const q = state.questions[state.current];

  document.getElementById(
    "arad-exam-content"
  ).innerHTML = `
    <div class="panel">
      <span class="badge">آزمون آنلاین</span>

      <h2>${escapeHTML(state.courseName)}</h2>

      <p>
        سؤال ${state.current + 1}
        از ${state.questions.length}
      </p>

      <div class="arad-progress">
        <span style="width:${
          ((state.current + 1) / state.questions.length) * 100
        }%"></span>
      </div>

      <h3>${escapeHTML(q[0])}</h3>

      <div id="arad-options">
        ${q[1].map((option, index) => `
          <button
            class="arad-answer ${
              state.answers[state.current] === index
                ? "selected"
                : ""
            }"
            onclick="aradChooseAnswer(${index})"
          >
            ${index + 1}. ${escapeHTML(option)}
          </button>
        `).join("")}
      </div>

      <button class="btn" onclick="aradNextQuestion()">
        ${
          state.current === state.questions.length - 1
            ? "ثبت و پایان آزمون"
            : "سؤال بعدی"
        }
      </button>

      <button class="btn secondary"
        onclick="aradCancelExam()">
        خروج از آزمون
      </button>
    </div>
  `;
}

function aradChooseAnswer(index) {
  if (!aradExamState) return;

  aradExamState.answers[
    aradExamState.current
  ] = index;

  aradShowExamQuestion();
}

function aradNextQuestion() {
  const state = aradExamState;

  if (!state) return;

  if (
    state.answers[state.current] === undefined
  ) {
    alert("ابتدا یک گزینه انتخاب کن.");
    return;
  }

  if (
    state.current < state.questions.length - 1
  ) {
    state.current++;
    aradShowExamQuestion();
  } else {
    aradFinishExam();
  }
}

function aradFinishExam() {
  const state = aradExamState;
  const db = aradExamDB();

  if (!state || !db.current) return;

  let correct = 0;

  state.questions.forEach((question, index) => {
    if (
      state.answers[index] === question[2]
    ) {
      correct++;
    }
  });

  const total = state.questions.length;

  const score = Math.round(
    (correct / total) * 100
  );

  db.quizResults = db.quizResults || {};

  db.quizResults[db.current] =
    db.quizResults[db.current] || [];

  db.quizResults[db.current].push({
    courseId: state.courseId,
    courseName: state.courseName,
    correct,
    total,
    score,
    date: new Date().toLocaleDateString("fa-IR")
  });

  aradExamSave(db);

  let review = "";

  state.questions.forEach((question, index) => {
    const right = question[2];
    const selected = state.answers[index];

    review += `
      <div class="arad-result-card">
        <h3>${escapeHTML(question[0])}</h3>
        <p>
          پاسخ تو:
          ${escapeHTML(question[1][selected])}
        </p>
        <p>
          پاسخ صحیح:
          ${escapeHTML(question[1][right])}
        </p>
        <strong style="color:${
          selected === right ? "#4ade80" : "#f87171"
        }">
          ${selected === right ? "پاسخ صحیح ✓" : "پاسخ اشتباه ✗"}
        </strong>
      </div>
    `;
  });

  document.getElementById(
    "arad-exam-content"
  ).innerHTML = `
    <div class="panel">
      <h1>🏆 نتیجه آزمون</h1>

      <div class="arad-score">${score} از ۱۰۰</div>

      <h3>${correct} پاسخ صحیح از ${total} سؤال</h3>

      <p>
        ${
          score >= 90
            ? "فوق‌العاده! عملکرد عالی داشتی."
            : score >= 70
              ? "آفرین! نتیجه خوبی گرفتی."
              : score >= 50
                ? "خوب است، اما بیشتر تمرین کن."
                : "نیاز به تمرین بیشتری داری."
        }
      </p>

      <h2>بررسی پاسخ‌ها</h2>
      ${review}

      <button class="btn"
        onclick="aradRenderReport()">
        مشاهده کارنامه
      </button>
    </div>
  `;

  aradExamState = null;
  aradRenderReport();
}

function aradCancelExam() {
  if (!confirm("از آزمون خارج می‌شوی؟")) return;

  aradExamState = null;

  document.getElementById(
    "arad-exam-content"
  ).innerHTML = "";
}

function aradRenderReport() {
  const db = aradExamDB();

  const report = document.getElementById(
    "arad-report"
  );

  if (!report) return;

  if (!db.current) {
    report.innerHTML =
      "<p>برای مشاهده کارنامه وارد حساب شو.</p>";
    return;
  }

  const user = (db.users || []).find(
    u => u.email === db.current
  );

  if (!user) {
    report.innerHTML = "<p>حساب دانش‌آموز پیدا نشد.</p>";
    return;
  }

  const results =
    (db.quizResults || {})[db.current] || [];

  const grades = (db.grades || []).filter(
    g => g.email === db.current
  );

  const allScores = [
    ...results.map(r => Number(r.score)),
    ...grades.map(g => Number(g.score))
  ];

  const average = allScores.length
    ? Math.round(
        allScores.reduce((a, b) => a + b, 0) /
        allScores.length
      )
    : 0;

  report.innerHTML = `
    <div class="arad-result-card">
      <h3>👤 ${escapeHTML(user.name)}</h3>
      <p>${escapeHTML(user.email)}</p>

      <div class="grid">
        <div class="stat">
          <strong>${results.length}</strong>
          آزمون انجام‌شده
        </div>

        <div class="stat">
          <strong>${grades.length}</strong>
          نمره مدیر
        </div>

        <div class="stat">
          <strong>${average}</strong>
          میانگین نمرات
        </div>
      </div>
    </div>

    <h3>🧠 نتایج آزمون‌ها</h3>

    ${
      results.map(r => `
        <div class="arad-result-card">
          <strong>${escapeHTML(r.courseName)}</strong>
          <p>نمره: ${r.score} از ۱۰۰</p>
          <p>پاسخ صحیح: ${r.correct} از ${r.total}</p>
          <small>${escapeHTML(r.date)}</small>
        </div>
      `).join("") || "<p>هنوز آزمونی انجام نداده‌ای.</p>"
    }

    <h3>👑 نمرات ثبت‌شده توسط مدیر</h3>

    ${
      grades.map(g => `
        <div class="arad-result-card">
          <strong>${escapeHTML(g.course)}</strong>
          <div class="arad-score">${g.score}/100</div>
          <p>${escapeHTML(g.description || "بدون توضیحات")}</p>
          <small>${escapeHTML(g.date || "")}</small>
        </div>
      `).join("") || "<p>هنوز نمره‌ای از طرف مدیر ثبت نشده است.</p>"
    }
  `;
}

/* INITIALIZE */

aradLoadExamCourses();
aradRenderReport();

</script>

