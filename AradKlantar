aradStudentDB.certificates = aradStudentDB.certificates || {};

function aradSaveDB() {
 localStorage.setItem(
  ARAD_STUDENT_KEY,
  JSON.stringify(aradStudentDB)
 );
}

function aradMessage(message) {
 document.getElementById("aradAuthMessage").textContent = message;
}

function aradShowAuth(type) {
 document.getElementById("aradRegisterForm").style.display =
  type === "register" ? "block" : "none";

 document.getElementById("aradLoginForm").style.display =
  type === "login" ? "block" : "none";

 aradMessage("");
}

function aradRegister() {
 const name = document.getElementById("aradRegName").value.trim();
 const email = document.getElementById("aradRegEmail").value.trim().toLowerCase();
 const password = document.getElementById("aradRegPass").value;

 if(!name || !email || password.length < 8) {
  aradMessage("نام، ایمیل و رمز حداقل ۸ کاراکتری لازم است.");
  return;
 }

 if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
  aradMessage("ایمیل معتبر وارد کن.");
  return;
 }

 if(aradStudentDB.users.some(u => u.email === email)) {
  aradMessage("این ایمیل قبلاً ثبت شده است.");
  return;
 }

 const user = {
  id: "student_" + Date.now(),
  name,
  email,
  password,
  createdAt: new Date().toISOString()
 };

 aradStudentDB.users.push(user);
 aradStudentDB.current = user.id;

 aradSaveDB();
 aradRenderDashboard();
}

function aradLogin() {
 const email = document.getElementById("aradLoginEmail").value.trim().toLowerCase();
 const password = document.getElementById("aradLoginPass").value;

 const user = aradStudentDB.users.find(
  u => u.email === email && u.password === password
 );

 if(!user) {
  aradMessage("ایمیل یا رمز عبور اشتباه است.");
  return;
 }

 aradStudentDB.current = user.id;
 aradSaveDB();
 aradRenderDashboard();
}

function aradCurrentUser() {
 return aradStudentDB.users.find(
  u => u.id === aradStudentDB.current
 );
}

function aradLogout() {
 aradStudentDB.current = null;
 aradSaveDB();

 document.getElementById("aradStudentDashboard").style.display = "none";
 document.getElementById("aradAuthPanel").style.display = "block";

 aradShowAuth("login");
 aradMessage("با موفقیت خارج شدی.");
}

function aradGetCourses() {
 if(typeof ARAD_COURSES !== "undefined") {
  return ARAD_COURSES;
 }
 return [];
}

function aradRenderDashboard() {
 const user = aradCurrentUser();

 if(!user) {
  document.getElementById("aradStudentDashboard").style.display = "none";
  document.getElementById("aradAuthPanel").style.display = "block";
  return;
 }

 document.getElementById("aradAuthPanel").style.display = "none";
 document.getElementById("aradStudentDashboard").style.display = "block";

 document.getElementById("aradStudentName").textContent = user.name;
 document.getElementById("aradStudentEmail").textContent = user.email;

 const courses = aradGetCourses();
 let totalDone = 0;
 let totalScore = 0;
 let examCount = 0;

 const progressHTML = courses.map(course => {
  const done = aradStudentDB.progress[course.id] || [];
  const total = course.lessons.length;
  totalDone += done.length;

  const percent = total
   ? Math.round(done.length / total * 100)
   : 0;

  return `
   <div class="arad-progress-item">
    <strong>${aradEscape(course.name)}</strong>
    <p>${done.length} از ${total} درس - ${percent}٪</p>
    <div class="arad-progress-track">
     <span style="width:${percent}%"></span>
    </div>
   </div>
  `;
 }).join("");

 document.getElementById("aradProgressList").innerHTML =
  progressHTML || "هنوز دوره‌ای وجود ندارد.";

 const examHTML = [];

 Object.entries(aradStudentDB.exams).forEach(([courseId,results]) => {
  results.filter(r => r.userId === user.id).forEach(result => {
   totalScore += result.percent;
   examCount++;

   examHTML.push(`
    <div class="arad-result-item">
     <strong>${aradEscape(result.courseName)}</strong>
     <p>نمره: ${result.score} از ${result.total}</p>
     <p>درصد: ${result.percent}٪</p>
     <small>${new Date(result.date).toLocaleDateString("fa-IR")}</small>
    </div>
   `);
  });
 });

 document.getElementById("aradExamResults").innerHTML =
  examHTML.join("") || "هنوز در آزمونی شرکت نکرده‌ای.";

 document.getElementById("aradTotalCourses").textContent = courses.length;
 document.getElementById("aradDoneLessons").textContent = totalDone;
 document.getElementById("aradAverageScore").textContent =
  examCount ? Math.round(totalScore / examCount) : 0;

 const certificateHTML = courses.map(course => {
  const done = aradStudentDB.progress[course.id] || [];
  const completed = course.lessons.length > 0 &&
   done.length >= course.lessons.length;

  if(!completed) return "";

  return `
   <div class="arad-certificate">
    <h3>🏆 ${aradEscape(course.name)}</h3>
    <p>تمام درس‌های این دوره تکمیل شده است.</p>
    <button class="arad-main-btn"
     onclick="aradPrintCertificate('${course.id}')">
     دریافت گواهی
    </button>
   </div>
  `;
 }).join("");

 document.getElementById("aradCertificates").innerHTML =
  certificateHTML || "برای دریافت گواهی، تمام درس‌های دوره را تکمیل کن.";

 const exercises = aradStudentDB.exercises[user.id] || {};

 document.getElementById("aradSavedExercises").innerHTML =
  Object.keys(exercises).length
   ? Object.entries(exercises).map(([key,value]) => `
     <div class="arad-result-item">
      <strong>${aradEscape(key)}</strong>
      <p>${aradEscape(value).slice(0,300)}</p>
     </div>
    `).join("")
   : "هنوز تمرینی ذخیره نشده است.";
}

function aradEscape(value) {
 return String(value).replace(/[&<>"']/g, c => ({
  "&":"&amp;",
  "<":"&lt;",
  ">":"&gt;",
  '"':"&quot;",
  "'":"&#39;"
 })[c]);
}

function aradCompleteLesson(courseId,lessonIndex) {
 const user = aradCurrentUser();

 if(!user) {
  alert("ابتدا وارد حساب دانش‌آموزی شو.");
  return;
 }

 aradStudentDB.progress[courseId] =
  aradStudentDB.progress[courseId] || [];

 if(!aradStudentDB.progress[courseId].includes(lessonIndex)) {
  aradStudentDB.progress[courseId].push(lessonIndex);
 }

 aradSaveDB();
 aradRenderDashboard();

 alert("پیشرفت درس ذخیره شد.");
}

function aradSaveExercise(courseId,lessonIndex,value) {
 const user = aradCurrentUser();

 if(!user) {
  alert("ابتدا وارد حساب شو.");
  return;
 }

 aradStudentDB.exercises[user.id] =
  aradStudentDB.exercises[user.id] || {};

 const key = courseId + "_lesson_" + lessonIndex;

 aradStudentDB.exercises[user.id][key] = value;

 aradSaveDB();
 alert("تمرین ذخیره شد.");
}

function aradRecordExam(courseId,courseName,score,total) {
 const user = aradCurrentUser();

 if(!user) {
  alert("برای ثبت نمره وارد حساب شو.");
  return;
 }

 aradStudentDB.exams[courseId] =
  aradStudentDB.exams[courseId] || [];

 const percent = total > 0
  ? Math.round(score / total * 100)
  : 0;

 aradStudentDB.exams[courseId].push({
  userId:user.id,
  courseName,
  score,
  total,
  percent,
  date:new Date().toISOString()
 });

 aradSaveDB();
 aradRenderDashboard();
}

function aradPrintCertificate(courseId) {
 const user = aradCurrentUser();
 const course = aradGetCourses().find(c => c.id === courseId);

 if(!user || !course) return;

 const done = aradStudentDB.progress[courseId] || [];

 if(done.length < course.lessons.length) {
  alert("هنوز همه درس‌ها تکمیل نشده‌اند.");
  return;
 }

 const win = window.open("", "_blank");

 if(!win) {
  alert("پنجره چاپ مسدود شده است.");
  return;
 }

 const html = `
 <!DOCTYPE html>
 <html lang="fa" dir="rtl">
 <head>
 <meta charset="UTF-8">
 <title>گواهی آکادمی اراد</title>
 <style>
 body {
  background:#071326;
  color:#fff;
  font-family:Tahoma;
  text-align:center;
  padding:35px;
 }
 .certificate {
  border:8px double #38bdf8;
  padding:55px 20px;
  margin:auto;
  max-width:800px;
 }
 h1 {color:#67e8f9}
 @media print {
  body {background:white;color:#111}
  h1 {color:#087eaa}
 }
 </style>
 </head>
 <body>
 <div class="certificate">
  <h1>ARAD KALANTER ACADEMY</h1>
  <h2>گواهی پایان دوره</h2>
  <p>این گواهی به نام</p>
  <h2>${aradEscape(user.name)}</h2>
  <p>برای تکمیل دوره آموزشی زیر صادر شده است:</p>
  <h2>${aradEscape(course.name)}</h2>
  <p>تاریخ صدور: ${new Date().toLocaleDateString("fa-IR")}</p>
  <p>ARAD ACADEMY</p>
  <button onclick="window.print()">چاپ گواهی</button>
 </div>
 </body>
 </html>
 `;

 win.document.open();
 win.document.write(html);
 win.document.close();
}

if(aradCurrentUser()) {
 aradRenderDashboard();
}
</script>

