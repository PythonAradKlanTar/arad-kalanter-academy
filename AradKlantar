    container.querySelectorAll("[data-review]").forEach(button => {
      button.addEventListener("click", function () {
        if (!isAdmin()) return;

        const id = this.dataset.review;

        const scoreValue = $(
          "aradScore_" + id
        ).value;

        const feedback = $(
          "aradFeedback_" + id
        ).value.trim();

        const score = scoreValue === ""
          ? null
          : Number(scoreValue);

        if (
          score !== null &&
          (!Number.isInteger(score) || score < 0 || score > 100)
        ) {
          alert("نمره باید عددی بین صفر تا ۱۰۰ باشد.");
          return;
        }

        const data = getData();

        const item = data.submissions.find(
          submission => submission.id === id
        );

        if (!item) return;

        item.score = score;
        item.feedback = feedback;
        item.status = "بررسی شد";
        item.reviewedAt = new Date().toISOString();

        saveData(data);

        render();

        alert("بررسی پروژه با موفقیت ثبت شد.");
      });
    });

    /* حذف پروژه */
    container.querySelectorAll("[data-delete]").forEach(button => {
      button.addEventListener("click", function () {
        if (!isAdmin()) return;

        if (!confirm("این پروژه حذف شود؟")) return;

        const id = this.dataset.delete;
        const data = getData();

        data.submissions = data.submissions.filter(
          item => item.id !== id
        );

        saveData(data);

        render();

        alert("پروژه حذف شد.");
      });
    });
  }

  /* ارسال پروژه */
  $("aradAssignmentForm").addEventListener(
    "submit",
    function (event) {
      event.preventDefault();

      const student = getStudent();

      if (!student) {
        alert("ابتدا وارد حساب دانش‌آموزی شو.");
        return;
      }

      const courseId = $("aradAssignmentCourse").value;
      const title = $("aradAssignmentTitle").value.trim();
      const description =
        $("aradAssignmentDescription").value.trim();

      const code = $("aradAssignmentCode").value.trim();

      const course = getCourses().find(
        item => item.id === courseId
      );

      if (!course || !title || !description) {
        alert("اطلاعات پروژه را کامل وارد کن.");
        return;
      }

      if (!Array.isArray(getCourses()) ||
          !getCourses().some(item => item.id === courseId)) {
        alert("دوره انتخاب‌شده معتبر نیست.");
        return;
      }

      const data = getData();

      data.submissions.push({
        id: "ARAD-PROJECT-" + Date.now() + "-" +
            Math.random().toString(36).slice(2, 7),

        studentId: student.id,
        studentName: student.name,
        studentEmail: student.email,

        courseId: course.id,
        courseName: course.name,

        title,
        description,
        code,

        status: "ارسال شده",
        score: null,
        feedback: "",

        createdAt: new Date().toISOString()
      });

      saveData(data);

      this.reset();

      render();

      alert("🎉 پروژه با موفقیت ارسال شد!");
    }
  );

  /* بروزرسانی همه قسمت‌ها */
  function render() {
    renderCourses();
    renderMyAssignments();
    renderAdminAssignments();
  }

  /* امکان بروزرسانی بعد از ورود مدیر */
  window.aradAssignmentsRefresh = render;

  render();

  console.log("ARAD ACADEMY PART 13 READY");

})();
</script>

