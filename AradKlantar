   </p>
   <button onclick="aradAddCart('${p.id}')">
    افزودن به سبد خرید
   </button>
  </article>
 `).join("");

 window.aradRenderCart();
 window.aradRenderOrders();
 window.aradShowPurchases();
};

window.aradAddCart=function(id){

 if(!userKey()){
  alert("ابتدا وارد حساب کاربری شو.");
  return;
 }

 const product=products.find(p=>p.id===id);
 if(!product) return;

 const data=getStore();
 const key=userKey();

 data.carts[key]=data.carts[key] || [];

 if(data.carts[key].includes(id)){
  alert("این دوره قبلاً در سبد خرید قرار گرفته است.");
  return;
 }

 const purchased=data.purchases[key] || [];

 if(purchased.includes(id)){
  alert("این دوره را قبلاً خریداری کرده‌ای.");
  return;
 }

 data.carts[key].push(id);
 saveStore(data);

 window.aradRenderCart();

 alert("دوره به سبد خرید اضافه شد.");
};

window.aradRenderCart=function(){

 const key=userKey();
 const data=getStore();
 const cart=key ? (data.carts[key] || []) : [];

 let total=0;

 const html=cart.map(id=>{
  const p=products.find(x=>x.id===id);
  if(!p) return "";
  total+=p.price;

  return `
   <div>
    <strong>${escapeText(p.name)}</strong>
    <span>${p.price.toLocaleString("fa-IR")} تومان</span>
    <button class="secondary"
     onclick="aradRemoveCart('${id}')">حذف</button>
   </div>
  `;
 }).join("");

 document.getElementById("aradCartContent").innerHTML=
  html || "سبد خرید خالی است.";

 document.getElementById("aradCartTotal").textContent=
  "مجموع: "+total.toLocaleString("fa-IR")+" تومان";
};

window.aradRemoveCart=function(id){

 const data=getStore();
 const key=userKey();

 if(!key) return;

 data.carts[key]=(data.carts[key] || []).filter(x=>x!==id);

 saveStore(data);
 window.aradRenderCart();
};

window.aradClearCart=function(){

 const data=getStore();
 const key=userKey();

 if(!key) return;

 data.carts[key]=[];

 saveStore(data);
 window.aradRenderCart();
};

window.aradCheckout=function(){

 const key=userKey();

 if(!key){
  alert("ابتدا وارد حساب کاربری شو.");
  return;
 }

 const data=getStore();
 const cart=data.carts[key] || [];

 if(!cart.length){
  alert("سبد خرید خالی است.");
  return;
 }

 const items=cart.map(id=>products.find(p=>p.id===id)).filter(Boolean);

 const total=items.reduce((sum,p)=>sum+p.price,0);

 const order={
  id:"ARAD-"+Date.now(),
  email:key,
  items:items.map(p=>p.id),
  total,
  status:"در انتظار پرداخت",
  date:new Date().toLocaleString("fa-IR")
 };

 data.orders.push(order);
 data.carts[key]=[];

 saveStore(data);

 document.getElementById("aradPaymentMessage").textContent=
  "سفارش "+order.id+" ثبت شد. مبلغ: "+
  total.toLocaleString("fa-IR")+" تومان. پرداخت هنوز انجام نشده است.";

 window.aradRenderCart();
 window.aradRenderOrders();

 alert("سفارش آزمایشی ثبت شد. هیچ پولی برداشت نشده است.");
};

window.aradRenderOrders=function(){

