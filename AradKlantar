function getStore(){
 try{
  return JSON.parse(localStorage.getItem(STORE_KEY)) || {
   carts:{},
   orders:[],
   purchases:{}
  };
 }catch{
  return {carts:{},orders:[],purchases:{}};
 }
}

function saveStore(data){
 localStorage.setItem(STORE_KEY,JSON.stringify(data));
}

function currentUser(){
 try{
  const db=JSON.parse(localStorage.getItem("aradAcademyDB"));
  if(!db || !db.current) return null;
  return db.users.find(u=>u.email===db.current) || null;
 }catch{
  return null;
 }
}

function escapeText(value){
 return String(value ?? "").replace(/[&<>"']/g,c=>({
  "&":"&amp;",
  "<":"&lt;",
  ">":"&gt;",
  '"':"&quot;",
  "'":"&#39;"
 })[c]);
}

function userKey(){
 const user=currentUser();
 return user ? user.email : null;
}

window.aradRenderStore=function(){

 const user=currentUser();

 document.getElementById("aradStoreUser").textContent=
  user ? "خوش آمدی "+user.name : "برای خرید وارد حساب کاربری شو.";

 const data=getStore();
 const key=userKey();

 const purchased=key ? (data.purchases[key] || []) : [];

 document.getElementById("aradStoreCount").textContent=
  "دوره‌های خریداری‌شده: "+purchased.length;

 document.getElementById("aradStoreProducts").innerHTML=
 products.map(p=>`
