function academyRenderCourses(){
 const query=(document.getElementById('academySearch')?.value||'').toLowerCase();
 const grid=document.getElementById('academyCourseGrid');
 if(!grid)return;
 grid.innerHTML=ARAD_COURSES.filter(c=>(c.name+' '+c.description).toLowerCase().includes(query)).map(c=>`
  <article class="academy-card">
   <div style="font-size:42px">${c.icon}</div>
   <h3>${c.name}</h3>
   <p>${c.description}</p>
   <p>سطح: ${c.level}</p>
   <p>تعداد درس: ${c.lessons.length}</p>
   <button class="academy-btn" onclick="academyOpenCourse('${c.id}')">مشاهده دوره ←</button>
  </article>
 `).join('') || '<p>دوره‌ای یافت نشد.</p>';
}

function academyOpenCourse(id){
 const course=ARAD_COURSES.find(c=>c.id===id);
 if(!course)return;
 const target=document.getElementById('academyCourseDetails');
 target.innerHTML=`
  <div class="academy-details">
   <h2>${course.icon} ${course.name}</h2>
   <p>${course.description}</p>
   <div class="academy-chapter">
    <h3>فصل اول: آموزش و تمرین</h3>
    ${course.lessons.map((lesson,index)=>`
     <div class="academy-lesson">
      <h4>درس ${index+1}: ${lesson[0]}</h4>
      <p>${lesson[1]}</p>
      <pre><code>${academyEscape(lesson[2])}</code></pre>
      <p>تمرین: یک نمونه مستقل از موضوع این درس بنویس و نتیجه را بررسی کن.</p>
      <a target="_blank" rel="noopener" href="https://www.youtube.com/results?search_query=${encodeURIComponent(course.name+' '+lesson[0]+' tutorial')}">🎬 جستجوی ویدیوی آموزشی</a>
     </div>
    `).join('')}
   </div>
  </div>
 `;
 target.scrollIntoView({behavior:'smooth'});
}

function academyEscape(value){
 return String(value).replace(/[&<>"']/g,c=>({
  '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
 })[c]);
}

academyRenderCourses();
