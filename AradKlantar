    if (!activeKey || !progress[activeKey]?.bookmark) {
      alert("نشانکی برای این ویدئو ذخیره نشده است.");
      return;
    }

    $("aradVideoPlayer").currentTime =
      progress[activeKey].bookmark;

    $("aradVideoMessage").textContent =
      "به محل نشانک منتقل شدی.";
  });

  $("aradSubtitleLoad").addEventListener("click", function () {
    const url = $("aradSubtitleURL").value.trim();
    const player = $("aradVideoPlayer");

    if (!url) {
      alert("آدرس زیرنویس را وارد کن.");
      return;
    }

    try {
      if (new URL(url).protocol !== "https:") {
        throw new Error("HTTPS required");
      }
    } catch {
      alert("آدرس زیرنویس HTTPS معتبر وارد کن.");
      return;
    }

    player.querySelectorAll("track").forEach(t => t.remove());

    const track = document.createElement("track");
    track.kind = "subtitles";
    track.label = "فارسی";
    track.srclang = "fa";
    track.src = url;
    track.default = true;

    player.appendChild(track);

    $("aradVideoMessage").textContent =
      "زیرنویس اضافه شد.";
  });

  $("aradSaveNotes").addEventListener("click", function () {
    if (!activeKey) {
      alert("ابتدا یک درس انتخاب کن.");
      return;
    }

    const progress = getProgress();

    progress[activeKey] = progress[activeKey] || {};

    progress[activeKey].notes =
      $("aradVideoNotes").value;

    saveProgress(progress);

    $("aradVideoMessage").textContent =
      "یادداشت‌ها ذخیره شدند.";
  });

  $("aradVideoLesson").addEventListener("change", function () {
    const courseId = $("aradVideoCourse").value;

    if (!courseId || !this.value) return;

    activeKey = courseId + "_" + this.value;

    const saved = getProgress()[activeKey] || {};

    $("aradVideoNotes").value = saved.notes || "";
  });

  console.log("ARAD PART 12 READY");

})();

