function aradSaveLastLesson(course,lesson) {
 localStorage.setItem(
  "aradLastLesson",
  JSON.stringify({course,lesson})
 );
}

function aradRefreshDashboard() {

 if(typeof db==="undefined" || !db) return;

 const courses=db.courses||[];
 const progress=db.progress||{};
 const currentUser=(db.users||[]).find(
  u=>u.email===db.current
 );

 let totalLessons=0;
 let completedLessons=0;

 courses.forEach(course=>{
  course.chapters.forEach(chapter=>{
   totalLessons+=chapter.lessons.length;
  });
  completedLessons+=
   (progress[course.id]||[]).length;
 });

 const percent=totalLessons
  ?Math.round(completedLessons/totalLessons*100):0;

 document.getElementById("aradDashCourses").textContent=
  courses.length;

 document.getElementById("aradDashDone").textContent=
  completedLessons;

 document.getElementById("aradDashProgress").style.width=
  percent+"%";

 document.getElementById("aradDashPercent").textContent=
  percent+"٪ تکمیل شده";

 const last=JSON.parse(
  localStorage.getItem("aradLastLesson")||"null"
 );

