<script>
(function(){

const FINANCE_KEY = "arad_academy_store_v1";
const CARD_KEY = "arad_finance_card_reference";

function isAdmin(){
  return sessionStorage.getItem("arad_admin_session")==="active";
}

function getData(){
  try{
    return JSON.parse(localStorage.getItem(FINANCE_KEY)) || {
      carts:{},
      orders:[],
      purchases:{},
      withdrawals:[]
    };
  }catch{
    return {
      carts:{},
      orders:[],
      purchases:{},
      withdrawals:[]
    };
  }
}

function saveData(data){
  localStorage.setItem(FINANCE_KEY,JSON.stringify(data));
}

function money(value){
  return Number(value || 0).toLocaleString("fa-IR")+" تومان";
}

function safe(value){
  return String(value ?? "").replace(/[&<>"']/g,c=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[c]);
}

window.aradFinanceOpen=function(){

  if(!isAdmin()){
    alert("ابتدا با حساب مدیر وارد شو.");
    return;
  }

  document.getElementById("aradFinance").classList.add("active");
  window.aradFinanceRefresh();
};

window.aradFinanceClose=function(){
  document.getElementById("aradFinance").classList.remove("active");
};

window.aradSaveCardReference=function(){

  if(!isAdmin()) return;

  const last4=document.getElementById("financeCardLast4").value.trim();

  if(!/^[0-9]{4}$/.test(last4)){
    alert("چهار رقم آخر کارت را صحیح وارد کن.");
    return;
  }

  localStorage.setItem(CARD_KEY,last4);

  document.getElementById("financeCardStatus").textContent=
    "شناسه کارت با چهار رقم پایانی "+last4+" ثبت شد.";

  alert("شناسه کارت ثبت شد. این ثبت، حساب بانکی را به درگاه متصل نمی‌کند.");
};

window.aradRequestWithdrawal=function(){

  if(!isAdmin()) return;

  const amount=Number(
    document.getElementById("financeAmount").value
  );

  const data=getData();

  const balance=data.orders
    .filter(o=>o.status==="paid")
    .reduce((sum,o)=>sum+Number(o.total || 0),0);

  if(!Number.isSafeInteger(amount) || amount<=0){
    alert("مبلغ معتبر وارد کن.");
    return;
  }

  if(amount>balance){
    alert("مبلغ درخواست از فروش تأییدشده بیشتر است.");
    return;
  }

  data.withdrawals=data.withdrawals || [];

  data.withdrawals.push({
    id:"WD-"+Date.now(),
    amount:amount,
    status:"در انتظار بررسی سرور",
    date:new Date().toLocaleString("fa-IR")
  });

  saveData(data);

  document.getElementById("financeAmount").value="";

  alert("درخواست محلی ثبت شد؛ هنوز برداشت واقعی انجام نشده است.");

  window.aradFinanceRefresh();
};

window.aradFinanceRefresh=function(){

  if(!isAdmin()) return;

  const data=getData();
  const orders=data.orders || [];
  const withdrawals=data.withdrawals || [];

  const paid=orders.filter(o=>o.status==="paid");

  const sales=paid.reduce(
    (sum,o)=>sum+Number(o.total || 0),0
  );

  document.getElementById("financeSales").textContent=money(sales);
  document.getElementById("financeBalance").textContent=money(sales);
  document.getElementById("financeOrders").textContent=orders.length;
  document.getElementById("financePaid").textContent=paid.length;
  document.getElementById("financeWithdrawals").textContent=withdrawals.length;

  document.getElementById("financeOrderList").innerHTML=
    orders.map(o=>`
      <div class="finance-record">
        <strong>${safe(o.id)}</strong>
        <p>کاربر: ${safe(o.email)}</p>
        <p>مبلغ: ${money(o.total)}</p>
        <p>وضعیت: ${safe(o.status)}</p>
        <p>تاریخ: ${safe(o.date)}</p>
      </div>
    `).join("") || "هنوز سفارشی وجود ندارد.";

  document.getElementById("financeWithdrawalList").innerHTML=
    withdrawals.map(w=>`
      <div class="finance-record">
        <strong>${safe(w.id)}</strong>
        <p>مبلغ: ${money(w.amount)}</p>
        <p>وضعیت: ${safe(w.status)}</p>
        <p>تاریخ: ${safe(w.date)}</p>
      </div>
    `).join("") || "درخواستی ثبت نشده است.";

  const card=localStorage.getItem(CARD_KEY);

  document.getElementById("financeCardStatus").textContent=
    card ? "شناسه کارت ثبت‌شده: **** "+card : "شناسه کارتی ثبت نشده است.";
};

})();
</script>

