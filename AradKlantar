      return;
    }

    const data = getData();

    data.items.push({
      id: "NOT-" + Date.now() + "-" +
        Math.random().toString(36).slice(2, 7),
      title,
      body,
      type,
      readBy: {},
      createdAt: new Date().toISOString()
    });

    saveData(data);
    this.reset();
    render();

    alert("اطلاعیه منتشر شد! 🎉");
  });

  section.addEventListener("click", function (event) {
    const readButton = event.target.closest("[data-read]");
    const deleteButton = event.target.closest("[data-delete]");

    if (readButton) {
      const user = getUser();
      if (!user) return;

      const data = getData();
      const item = data.items.find(
        x => x.id === readButton.dataset.read
      );

      if (item) {
        item.readBy = item.readBy || {};
        item.readBy[user.id] = true;
        saveData(data);
        render();
      }
    }

    if (deleteButton) {
      if (!isAdmin()) return;

      if (!confirm("این اطلاعیه حذف شود؟")) return;

      const data = getData();

      data.items = data.items.filter(
        x => x.id !== deleteButton.dataset.delete
      );

      saveData(data);
      render();
    }
  });

  window.aradNotificationsRefresh = render;

  render();

  console.log("ARAD PART 14 READY");

})();
