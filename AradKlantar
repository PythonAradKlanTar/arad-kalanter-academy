            id="teacherScore_${safe(item.id)}"
            value="${item.score ?? ""}"
          >

          <textarea
            id="teacherFeedback_${safe(item.id)}"
            placeholder="بازخورد استاد"
          >${safe(item.feedback)}</textarea>

          <button data-review="${safe(item.id)}">
            ثبت نمره و بازخورد
          </button>
        </div>
      `).join("")
      : "<p>هنوز تکلیفی ارسال نشده است.</p>";
  }

