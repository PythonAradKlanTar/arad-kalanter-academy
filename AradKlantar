<script>
(function () {
  "use strict";

  if (document.getElementById("aradCertificatesV20")) return;

  const KEY = "arad_certificates_v20";
  const $ = id => document.getElementById(id);

  function getDB() {
    try {
      return typeof aradStudentDB !== "undefined"
        ? aradStudentDB
        : null;
    } catch {
      return null;
    }
  }

  function getUser() {
    return typeof aradCurrentUser === "function"
      ? aradCurrentUser()
      : null;
  }

