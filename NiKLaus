    if(values.some(x=>!x))return alert("هر چهار گزینه لازم است.");

    draft.push({
      id:EXT.uid(),
      text,
      options:values,
      correctIndex:Number(answer.value),
      points:Math.max(1,Number(points.value)||1)
    });

