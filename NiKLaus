EXT.mount = function() {
  const root = EXT.root;
  root.replaceChildren(EXT.style);

  const header = EXT.h("div",{className:"top"});
  header.append(
    EXT.h("div",{},[
      EXT.h("h2",{text:"ARAD KALANTER ACADEMY"}),
      EXT.h("small",{text:"مرکز مدیریت و آموزش"})
    ]),
    EXT.button("بستن",() => root.remove(),"danger")
  );

  root.append(header);

  const nav = EXT.h("div",{className:"tabs"});

  Object.entries(EXT.tabs).forEach(([key,tab]) => {
    nav.append(EXT.button(
      tab.label,
      () => {
        EXT.activeTab = key;
        EXT.mount();
      },
      key === EXT.activeTab ? "" : "secondary"
    ));
  });

  root.append(nav);

  const content = EXT.h("div");
  root.append(content);

  const active = EXT.tabs[EXT.activeTab];
  if (active) active.render(content);
};

EXT.addTab = function(key,label,render) {
  EXT.tabs[key] = {label,render};
  EXT.mount();
};

EXT.open = () => {
  document.body.append(EXT.root);
  EXT.mount();
};

// IndexedDB storage for video and assignment files.
EXT.assetDB ||= new Promise((resolve,reject) => {
  const request = indexedDB.open("ARAD_ACADEMY_ASSETS_V1",1);

  request.onupgradeneeded = () => {
    const db = request.result;
    ["videos","submissions"].forEach(name => {
      if (!db.objectStoreNames.contains(name)) {
        db.createObjectStore(name,{keyPath:"id"});
      }
    });
  };

  request.onsuccess = () => resolve(request.result);
  request.onerror = () => reject(request.error);
});

EXT.putAsset = async (store,record) => {
  const db = await EXT.assetDB;
  return new Promise((resolve,reject) => {
    const tx = db.transaction(store,"readwrite");
    tx.objectStore(store).put(record);
    tx.oncomplete = () => resolve(true);
    tx.onerror = () => reject(tx.error);
  });
};

EXT.getAsset = async (store,id) => {
  const db = await EXT.assetDB;
  return new Promise((resolve,reject) => {
    const tx = db.transaction(store,"readonly");
    const request = tx.objectStore(store).get(id);
    request.onsuccess = () => resolve(request.result || null);
    request.onerror = () => reject(request.error);
  });
};

EXT.deleteAsset = async (store,id) => {
  const db = await EXT.assetDB;
  return new Promise((resolve,reject) => {
    const tx = db.transaction(store,"readwrite");
    tx.objectStore(store).delete(id);
    tx.oncomplete = () => resolve(true);
    tx.onerror = () => reject(tx.error);
  });
};

