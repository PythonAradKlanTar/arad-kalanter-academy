<script>
(function () {
  "use strict";

  if (document.getElementById("aradDebugCenter")) return;

  const KEY = "arad_debug_logs_v21";
  const MAX_LOGS = 150;

  const $ = id => document.getElementById(id);

  const timers = {};

  function safe(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[c]);
  }

  function stringify(value) {
    try {
      if (typeof value === "string") return value;
      return JSON.stringify(value);
    } catch {
      return String(value);
    }
  }

  function getLogs() {
    try {
      const logs = JSON.parse(
        localStorage.getItem(KEY) || "[]"
      );

      return Array.isArray(logs) ? logs : [];
    } catch {
      return [];
    }
  }

  function saveLogs(logs) {
    try {
      localStorage.setItem(
        KEY,
        JSON.stringify(logs.slice(-MAX_LOGS))
      );
    } catch {
      // اگر فضای ذخیره‌سازی پر باشد، سایت نباید متوقف شود.
    }
  }

  function record(type, message, details = "") {
    const logs = getLogs();

    logs.push({
      id: "LOG-" + Date.now() + "-" +
        Math.random().toString(36).slice(2, 7),

      type,
      message: String(message).slice(0, 2000),
      details: String(stringify(details)).slice(0, 4000),
      date: new Date().toISOString()
    });

    saveLogs(logs);

    if ($("aradDebugLogs")) {
      renderLogs();
    }
  }

  // ابزار عمومی برای استفاده در سایر بخش‌های سایت
  window.aradLogger = Object.freeze({

    info(message, details) {
      record("INFO", message, details);
    },

    warn(message, details) {
      record("WARNING", message, details);
    },

    error(message, details) {
      record("ERROR", message, details);
    },

    time(label) {
      timers[label] = performance.now();

      record(
        "INFO",
        "شروع اندازه‌گیری زمان: " + label
      );
    },

    timeEnd(label) {
      if (timers[label] === undefined) {
        record(
