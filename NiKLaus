    const email = field("ایمیل", "email");
    const phone = field("شماره موبایل", "tel");
    const password = field("رمز عبور", "password");
    const repeat = field("تکرار رمز عبور", "password");

    panel.append(
      name.wrapper,
      email.wrapper,
      phone.wrapper,
      password.wrapper,
      repeat.wrapper
    );

    const message = $("div");

    const submit = actionButton("ثبت‌نام");

    submit.onclick = async () => {
      submit.disabled = true;
      message.replaceChildren();

      try {
        if (password.control.value !== repeat.control.value) {
          throw new Error("تکرار رمز صحیح نیست.");
        }

        await registerStudent({
          name:name.control.value,
          email:email.control.value,
          phone:phone.control.value,
          password:password.control.value
        });

        showDashboard();
      } catch (error) {
        displayMessage(message, error.message, "warning");
      } finally {
        submit.disabled = false;
      }
    };

    panel.append(submit);

    panel.append(actionButton(
      "بازگشت به ورود",
      showLogin,
      "secondary"
    ));

    panel.append(message);

    root.append(panel);
  }

  // ==========================================
  // DASHBOARD
  // ==========================================

  function showDashboard() {
    const student = currentStudent();

    if (!student) {
      return showLogin();
    }

    root.replaceChildren(root.querySelector("style"));

    const header = $("div", {className:"topbar"});

    header.append(
      $("div", {}, [
        $("h1", {text:"داشبورد دانشجو"}),
        $("p", {
          className:"muted",
          text:"خوش آمدی " + student.name
        })
      ]),
      actionButton("خروج از حساب", logout, "danger")
    );

    root.append(header);

    const tabs = $("div", {className:"tabs"});

    const content = $("div");

    function navigate(page) {
      content.replaceChildren();

      if (page === "courses") showCourses(student, content);
      if (page === "profile") showProfile(student, content);
      if (page === "progress") showProgress(student, content);
      if (page === "notes") showNotes(student, content);
    }

    [
      ["دوره‌های من","courses"],
      ["پیشرفت آموزشی","progress"],
      ["پروفایل","profile"],
      ["یادداشت‌ها","notes"]
    ].forEach(([label, page]) => {
      tabs.append(actionButton(
        label,
        () => navigate(page),
        "secondary"
      ));
    });

    root.append(tabs, content);

    navigate("courses");
  }

  // ==========================================
  // COURSES
  // ==========================================

  function showCourses(student, container) {
    container.append(title("دوره‌های آکادمی"));

    const courses = DB.courses || [];

    if (!courses.length) {
      displayMessage(
        container,
        "هنوز دوره‌ای ساخته نشده است."
      );
      return;
    }

    courses.forEach(course => {
      const box = card(course.title);

      displayMessage(
        box,
        course.description || "بدون توضیحات"
      );

      const enrolled = isEnrolled(student, course.id);
      const percent = courseProgress(student, course);

      const progress = $("div", {className:"progress"});
      const fill = $("div", {style:`width:${percent}%`});

      progress.append(fill);

      box.append(
        $("p", {
          text:`پیشرفت: ${percent} درصد`
        }),
        progress
      );

      if (!enrolled) {
        const enrollButton = actionButton(
          Number(course.price || 0) > 0
            ? "دوره پولی"
            : "ثبت‌نام رایگان",
          () => {
            try {
              enrollInFreeCourse(student, course);
              showDashboard();
            } catch (error) {
              alert(error.message);
            }
          }
        );

        enrollButton.disabled =
          Number(course.price || 0) > 0;

        box.append(enrollButton);
      } else {
        box.append(actionButton(
          "مشاهده جلسات",
          () => showCourseLessons(student, course)
        ));
      }

      container.append(box);
    });
  }

  // ==========================================
  // LESSONS
  // ==========================================

  function showCourseLessons(student, course) {
    root.replaceChildren(root.querySelector("style"));

    root.append(
      $("div", {className:"topbar"}, [
        $("h2", {text:course.title}),
        actionButton("بازگشت", showDashboard, "secondary")
      ])
    );

    const percentage = courseProgress(student, course);

    root.append($("div", {className:"card"}, [
      $("strong", {text:`پیشرفت دوره: ${percentage}%`})
    ]));

    (course.chapters || []).forEach(chapter => {
      const box = card("📁 " + chapter.title);

      (chapter.lessons || []).forEach(lesson => {
        const completed =
          Boolean(student.progress[lesson.id]?.completed);

        const row = $("div", {className:"lesson"});

        row.append(
          $("strong", {text:lesson.title}),
          $("p", {
            className:completed ? "success" : "muted",
            text:completed ? "تکمیل شده" : "در انتظار مشاهده"
          })
        );

        if (lesson.videoUrl) {
          try {
            const url = new URL(lesson.videoUrl);

            if (["https:", "http:"].includes(url.protocol)) {
              row.append(actionButton(
                "باز کردن ویدئو",
                () => window.open(url.href, "_blank", "noopener")
              ));
            }
          } catch {
            row.append(displayMessage(
              row,
              "لینک ویدئو معتبر نیست.",
              "warning"
            ));
          }
        }

        row.append(actionButton(
          completed ? "لغو تکمیل" : "علامت‌گذاری به‌عنوان تکمیل‌شده",
          () => {
            if (completed) {
              unmarkLesson(student, lesson.id);
            } else {
              markLessonComplete(student, lesson.id);
            }

            showCourseLessons(student, course);
          },
          completed ? "secondary" : ""
        ));

        box.append(row);
      });

      root.append(box);
    });
  }

  // ==========================================
  // PROGRESS
  // ==========================================

  function showProgress(student, container) {
    container.append(title("گزارش پیشرفت"));

    DB.courses.forEach(course => {
      if (!isEnrolled(student, course.id)) return;

      const percent = courseProgress(student, course);

      const box = card(course.title);

      box.append(
        $("div", {
          className:"number",
          text:percent + "%"
        })
      );

      const progress = $("div", {className:"progress"});

      progress.append($("div", {
        style:`width:${percent}%`
      }));

      box.append(progress);

      box.append($("p", {
        className:"muted",
        text:`${allLessons(course).filter(
          l => student.progress[l.id]?.completed
        ).length} جلسه تکمیل‌شده از ${allLessons(course).length}`
      }));

      container.append(box);
    });
  }

  // ==========================================
  // PROFILE
  // ==========================================

  function showProfile(student, container) {
    container.append(title("پروفایل شخصی"));

    const name = field("نام", "text", student.name);
    name.control.value = student.name;

    const phone = field("موبایل");
    phone.control.value = student.phone || "";

    const bio = $("textarea", {
      placeholder:"درباره خودت بنویس..."
    });

    bio.value = student.bio || "";

    const box = card("ویرایش اطلاعات");

    box.append(
      name.wrapper,
      phone.wrapper,
      bio
    );

    box.append(actionButton(
      "ذخیره تغییرات",
      () => {
        if (name.control.value.trim().length < 2) {
          return alert("نام معتبر وارد کن.");
        }

        student.name = name.control.value.trim();
        student.phone = phone.control.value.trim();
        student.bio = bio.value.trim();

        save();
        alert("پروفایل به‌روزرسانی شد.");
        showDashboard();
      }
    ));

    container.append(box);

    const info = card("اطلاعات حساب");

    info.append(
      $("p", {text:"ایمیل: " + student.email}),
      $("p", {
        text:"تاریخ عضویت: " +
          new Date(student.createdAt).toLocaleDateString("fa-IR")
      })
    );

    container.append(info);

    const passwordBox = card("تغییر رمز عبور");

    const oldPassword = field("رمز فعلی", "password");
    const newPassword = field("رمز جدید", "password");
    const repeat = field("تکرار رمز جدید", "password");

    passwordBox.append(
      oldPassword.wrapper,
      newPassword.wrapper,
      repeat.wrapper
    );

    passwordBox.append(actionButton(
      "تغییر رمز",
      async () => {
        try {
          const valid = await verifyPassword(
            oldPassword.control.value,
            student
          );

          if (!valid) {
            throw new Error("رمز فعلی اشتباه است.");
          }

          if (newPassword.control.value.length < 10) {
            throw new Error("رمز جدید حداقل ۱۰ کاراکتر باشد.");
          }

          if (
            newPassword.control.value !== repeat.control.value
          ) {
            throw new Error("تکرار رمز صحیح نیست.");
          }

          const result = await hashPassword(
            newPassword.control.value
          );

          student.passwordHash = result.hash;
          student.passwordSalt = result.salt;

          save();
          alert("رمز جدید ذخیره شد.");
        } catch (error) {
          alert(error.message);
        }
      }
    ));

    container.append(passwordBox);
  }

  // ==========================================
  // NOTES
  // ==========================================

  function showNotes(student, container) {
    container.append(title("یادداشت‌های من"));

    const textarea = $("textarea", {
      placeholder:"یادداشت آموزشی جدید..."
    });

    const box = card("ثبت یادداشت");

    box.append(textarea);

    box.append(actionButton(
      "ذخیره یادداشت",
