            <p>${aradEscape(u.email)}</p>
            <button onclick="aradSelectStudent(${i})">
              ثبت نمره
            </button>
          </div>
        `).join("") || "<p>هنوز دانش‌آموزی ثبت نشده است.</p>"}
      </div>
    `;

    window.aradSelectStudent=function(i){
      const u=users[i];
      window.aradAdminTab("grades");
      document.getElementById("gradeEmail").value=u.email;
    };
  }

  if(tab==="grades"){

    content.innerHTML=`
      <div class="admin-box">
        <h2>📝 ثبت نمره دانش‌آموز</h2>

        <input id="gradeEmail"
