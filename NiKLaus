                </button>
              ` : ""}

              ${read ? '<small style="color:#4ade80">✓ خوانده شده</small>' : ""}
            </article>
          `;
        }).join("")
      : "<p>هنوز اطلاعیه‌ای منتشر نشده است.</p>";
