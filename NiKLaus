              </p>

              ${user && !read ? `
                <button data-read="${safe(item.id)}">
                  ✓ علامت‌گذاری به‌عنوان خوانده‌شده
                </button>
              ` : ""}

              ${admin ? `
                <button class="danger" data-delete="${safe(item.id)}">
