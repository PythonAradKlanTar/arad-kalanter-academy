      if (cert) cert.status = "revoked";

      saveData(data);
      render();
    }
  });

  window.aradCertificateRefresh = render;

  const nav = $("navLinks");

  if (nav && !$("aradCertificateNav")) {
    const button = document.createElement("button");

    button.id = "aradCertificateNav";
    button.type = "button";
    button.textContent = "مدارک 🏆";

    button.addEventListener("click", () => {
      window.showPage
        ? window.showPage("aradCertificatesV20", button)
        : section.classList.add("active");

      render();
    });

    nav.appendChild(button);
  }

  render();

  console.log("ARAD PART 20 READY");

})();
