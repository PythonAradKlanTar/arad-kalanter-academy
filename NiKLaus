  const target = document.querySelector("main") || document.body;
  target.appendChild(section);

  function validURL(value) {
    if (!value) return true;

    try {
      return ["http:", "https:"].includes(new URL(value).protocol);
    } catch {
      return false;
    }
  }

  function renderCourses() {
    const select = $("aradTeacherMaterialCourse");

    select.innerHTML =
      '<option value="">انتخاب دوره</option>' +
      courses().map(course => `
        <option value="${safe(course.id)}">
          ${safe(course.name)}
        </option>
      `).join("");
  }

  function renderAssignments() {
    const list = getAssignments();

    $("aradTeacherTotal").textContent = list.length;
    $("aradTeacherPending").textContent =
      list.filter(x => x.status !== "بررسی شد").length;
    $("aradTeacherReviewed").textContent =
      list.filter(x => x.status === "بررسی شد").length;

    $("aradTeacherAssignments").innerHTML = list.length
      ? list.map(item => `
        <div class="teacher-item">
          <h3>${safe(item.title)}</h3>
          <p>دانش‌آموز: ${safe(item.studentName)}</p>
          <p>ایمیل: ${safe(item.studentEmail)}</p>
          <p>دوره: ${safe(item.courseName)}</p>
          <p>${safe(item.description)}</p>

          ${item.code ? `
            <details>
              <summary>مشاهده کد پروژه</summary>
              <pre style="direction:ltr;white-space:pre-wrap">${safe(item.code)}</pre>
            </details>
          ` : ""}

          <p>وضعیت: ${safe(item.status)}</p>

          <input
