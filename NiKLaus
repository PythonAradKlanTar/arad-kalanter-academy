    box.append($("p",{
      text:"این نسخه شامل داده‌های ذخیره‌شده همین مرورگر است."
    }));

    box.append(btn("دانلود نسخه JSON",() => {
      const blob = new Blob(
        [JSON.stringify(DB,null,2)],
        {type:"application/json"}
      );

      const url = URL.createObjectURL(blob);
      const link = $("a",{
        href:url,
        download:"arad-academy-backup.json"
      });

      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);

      log("backup_exported");
    }));

    const file = $("input",{type:"file",accept:".json"});

    box.append(
      $("p",{text:"بازیابی نسخه پشتیبان"}),
      file
    );

    box.append(btn("بازیابی فایل",async () => {
      const selected = file.files[0];
      if (!selected) return alert("فایل انتخاب کن.");

      if (!confirm("اطلاعات فعلی جایگزین شوند؟")) return;

      try {
        const imported = JSON.parse(
          await selected.text()
        );

        if (
          !imported ||
          !Array.isArray(imported.courses) ||
          !Array.isArray(imported.students)
        ) {
          throw Error("ساختار فایل پشتیبان معتبر نیست.");
        }

        const localOwner = DB.settings.owner;
        const localManagers = DB.settings.managers;

        Object.keys(DB).forEach(key => delete DB[key]);
        Object.assign(DB,imported);

        DB.settings ||= {};
        DB.settings.owner = localOwner;
        DB.settings.managers = localManagers;

        DB.students ||= [];
        DB.announcements ||= [];
        DB.audit ||= [];

        save();
        alert("اطلاعات بازیابی شد.");
        renderDashboard();
      } catch (error) {
        alert("بازیابی انجام نشد: " + error.message);
      }
    }));

    parent.append(box);
  }

