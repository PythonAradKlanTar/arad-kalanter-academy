            ` : ""}

          </article>
        `).join("")
      : "<p>هنوز درخواست پشتیبانی ثبت نکرده‌ای.</p>";
  }

  function renderAdminTickets() {
    const container = $("aradAllTickets");
    const admin = isAdmin();

    $("aradAdminSupport").hidden = !admin;

    if (!admin) {
      container.innerHTML = "";
      return;
    }

    const tickets = getData().tickets;

    container.innerHTML = tickets.length
      ? tickets.map(ticket => `
          <article class="support-ticket">

            <h3>${safe(ticket.subject)}</h3>

            <p>دانش‌آموز: ${safe(ticket.userName)}</p>
            <p>ایمیل: ${safe(ticket.userEmail)}</p>
            <p>موضوع: ${safe(ticket.category)}</p>
            <p>شماره: ${safe(ticket.id)}</p>
            <p>${safe(ticket.message)}</p>

            <p class="support-status">
              وضعیت: ${safe(ticket.status)}
