// Only the owner can promote or demote secondary managers.
app.put(
  "/api/admin/users/:id/role",
  requireOwner,
  (req, res) => {
    const id = Number(req.params.id);
    const role = String(req.body.role || "");

    if (
      !Number.isSafeInteger(id) ||
      !["student", "admin"].includes(role)
    ) {
      return res.status(400).json({
        error: "اطلاعات نقش معتبر نیست."
      });
    }

    const target = db.prepare(`
      SELECT id, role FROM users WHERE id = ?
    `).get(id);

    if (!target || target.role === "owner") {
      return res.status(404).json({
        error: "کاربر قابل تغییر پیدا نشد."
      });
    }

    db.prepare(`
      UPDATE users SET role = ? WHERE id = ?
    `).run(role, id);

    audit(req, "change_user_role", `${id}:${role}`);

    res.json({ ok: true });
  }
);

// Manager: enable / disable student accounts
app.put(
  "/api/admin/users/:id/active",
  requireAdmin,
  (req, res) => {
    const id = Number(req.params.id);

    if (!Number.isSafeInteger(id)) {
      return res.status(400).json({
        error: "شناسه نامعتبر است."
      });
    }

    const target = db.prepare(`
      SELECT id, role FROM users WHERE id = ?
    `).get(id);

    if (!target || target.role === "owner") {
      return res.status(404).json({
        error: "کاربر پیدا نشد."
      });
    }

    db.prepare(`
      UPDATE users SET active = ? WHERE id = ?
    `).run(req.body.active ? 1 : 0, id);

    audit(req, "change_user_status", String(id));

    res.json({ ok: true });
  }
);

// Owner-only audit report
app.get(
  "/api/admin/audit",
  requireOwner,
  (req, res) => {
    const logs = db.prepare(`
      SELECT
        audit_logs.*,
        users.name AS user_name,
        users.email AS user_email
      FROM audit_logs
      LEFT JOIN users ON users.id = audit_logs.user_id
      ORDER BY audit_logs.id DESC
      LIMIT 200
    `).all();

    res.json(logs);
  }
);

