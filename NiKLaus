};

window.aradSaveGrade=function(){

  if(!adminIsOpen()) return;

  const email=document.getElementById("gradeEmail").value.trim();
  const course=document.getElementById("gradeCourse").value.trim();
  const value=Number(document.getElementById("gradeValue").value);
  const description=document.getElementById("gradeDescription").value.trim();

  if(!email || !course ||
     document.getElementById("gradeValue").value===""){
    alert("لطفاً اطلاعات نمره را کامل کن.");
    return;
  }

  if(!Number.isFinite(value) || value<0 || value>100){
    alert("نمره باید بین صفر تا صد باشد.");
    return;
  }

  const records=getRecords();

  records.grades.push({
    email,
    course,
    value,
    description,
    date:new Date().toLocaleDateString("fa-IR")
  });

  saveRecords(records);

  alert("✅ نمره با موفقیت ثبت شد.");

  window.aradAdminTab("grades");
};

window.aradDeleteGrade=function(index){

  if(!adminIsOpen()) return;

  if(!confirm("این نمره حذف شود؟")) return;

  const records=getRecords();

  records.grades.splice(index,1);

  saveRecords(records);

  window.aradAdminTab("grades");
};

function aradEscape(value){
  return String(value ?? "").replace(/[&<>"']/g,c=>({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[c]);
}

})();
</script>

