<script>
/* ARAD ADMIN SYSTEM */

const ARAD_ADMIN_PASSWORD = "AradKalantar1392";

function aradAdminLogin() {
  const password =
    document.getElementById("admin-password").value;

  if (password !== ARAD_ADMIN_PASSWORD) {
    document.getElementById("admin-error").textContent =
      "رمز مدیر اشتباه است!";
    return;
  }

  sessionStorage.setItem("arad_admin_session", "active");

  document.getElementById("admin-login").hidden = true;
  document.getElementById("admin-dashboard").hidden = false;

  aradRenderAdmin();
}

function aradAdminLogout() {
  sessionStorage.removeItem("arad_admin_session");

  document.getElementById("admin-login").hidden = false;
  document.getElementById("admin-dashboard").hidden = true;

  document.getElementById("admin-password").value = "";
}

function aradCheckAdmin() {
  if (sessionStorage.getItem("arad_admin_session") === "active") {
    document.getElementById("admin-login").hidden = true;
    document.getElementById("admin-dashboard").hidden = false;
    aradRenderAdmin();
  }
}

function aradGetDB() {
  return JSON.parse(localStorage.getItem("arad_academy_v2") || "{}");
}

function aradSaveDB(data) {
  localStorage.setItem("arad_academy_v2", JSON.stringify(data));
}

function aradRenderAdmin() {
  if (sessionStorage.getItem("arad_admin_session") !== "active") {
    return;
  }

  const db = aradGetDB();

  db.users = db.users || [];
  db.courses = db.courses || [];
  db.grades = db.grades || [];

  document.getElementById("admin-users-count").textContent =
    db.users.length;

  document.getElementById("admin-courses-count").textContent =
    db.courses.length;

  document.getElementById("admin-lessons-count").textContent =
    db.courses.reduce((sum, course) =>
      sum + (course.chapters || []).reduce(
        (n, chapter) => n + (chapter.lessons || []).length, 0
      ), 0
    );

  document.getElementById("admin-users").innerHTML =
    db.users.map((user, index) => `
      <div class="admin-user">
        <strong>${escapeHTML(user.name)}</strong>
        <p>${escapeHTML(user.email)}</p>
        <button class="admin-danger"
          onclick="aradDeleteUser(${index})">
          حذف دانش‌آموز
        </button>
      </div>
    `).join("") || "هنوز دانش‌آموزی ثبت‌نام نکرده است.";

  document.getElementById("admin-courses").innerHTML =
    db.courses.map(course => `
      <div class="admin-course">
        <strong>${escapeHTML(course.name)}</strong>
        <p>${escapeHTML(course.description || "")}</p>
        <p>قیمت: ${Number(course.price || 0).toLocaleString("fa-IR")} تومان</p>
        <button class="admin-danger"
          onclick="aradDeleteCourse('${course.id}')">
          حذف دوره
        </button>
      </div>
    `).join("");

  document.getElementById("grade-user").innerHTML =
    '<option value="">انتخاب دانش‌آموز</option>' +
    db.users.map(user => `
      <option value="${escapeHTML(user.email)}">
        ${escapeHTML(user.name)}
      </option>
    `).join("");

  document.getElementById("grade-course").innerHTML =
    '<option value="">انتخاب دوره</option>' +
    db.courses.map(course => `
      <option value="${escapeHTML(course.id)}">
        ${escapeHTML(course.name)}
      </option>
    `).join("");

  document.getElementById("admin-grades").innerHTML =
    db.grades.map((grade, index) => `
      <div class="admin-grade">
        <strong>${escapeHTML(grade.student)}</strong>
        <p>دوره: ${escapeHTML(grade.course)}</p>
        <p>نمره: ${grade.score} از ۱۰۰</p>
        <p>${escapeHTML(grade.description)}</p>
        <button class="admin-danger"
          onclick="aradDeleteGrade(${index})">
          حذف نمره
        </button>
      </div>
    `).join("") || "هنوز نمره‌ای ثبت نشده است.";
}

function aradAddCourse() {
  if (!aradIsAdmin()) return;

  const db = aradGetDB();

  const name = document.getElementById("admin-course-name").value.trim();
  const description = document.getElementById("admin-course-description").value.trim();
  const price = Number(document.getElementById("admin-course-price").value);

  if (!name || !Number.isSafeInteger(price) || price < 50000) {
    alert("نام دوره و قیمت حداقل ۵۰ هزار تومان لازم است.");
    return;
  }

  db.courses = db.courses || [];

  db.courses.push({
    id: "arad_" + Date.now(),
    name,
    icon: "📘",
    level: "ویژه",
    description,
    price,
    image: "",
    chapters: [{
      title: "فصل اول",
      lessons: [{
        title: "درس اول",
        body: "محتوای این درس را مدیر تکمیل می‌کند.",
        code: "print('Welcome to ARAD')",
        task: "تمرین این درس را انجام بده."
      }]
    }],
    quiz: []
  });

  aradSaveDB(db);
  aradRenderAdmin();

  alert("دوره با موفقیت اضافه شد.");
}

function aradGiveGrade() {
  if (!aradIsAdmin()) return;

  const db = aradGetDB();

  const email = document.getElementById("grade-user").value;
  const courseId = document.getElementById("grade-course").value;
  const score = Number(document.getElementById("grade-score").value);
  const description = document.getElementById("grade-description").value.trim();

  const user = (db.users || []).find(u => u.email === email);
  const course = (db.courses || []).find(c => c.id === courseId);

  if (!user || !course || !Number.isFinite(score) || score < 0 || score > 100) {
    alert("دانش‌آموز، دوره و نمره معتبر را انتخاب کن.");
    return;
  }

  db.grades = db.grades || [];

  db.grades.push({
    student: user.name,
    email: user.email,
    course: course.name,
    courseId,
    score,
    description,
    date: new Date().toLocaleDateString("fa-IR")
  });

  aradSaveDB(db);
  aradRenderAdmin();

  alert("نمره دانش‌آموز ثبت شد.");
}

function aradDeleteUser(index) {
  if (!aradIsAdmin()) return;
  if (!confirm("این دانش‌آموز حذف شود؟")) return;

  const db = aradGetDB();

  db.users.splice(index, 1);
  aradSaveDB(db);
  aradRenderAdmin();
}

function aradDeleteCourse(id) {
  if (!aradIsAdmin()) return;
  if (!confirm("این دوره حذف شود؟")) return;

  const db = aradGetDB();

  db.courses = db.courses.filter(course => course.id !== id);
  aradSaveDB(db);
  aradRenderAdmin();
}

function aradDeleteGrade(index) {
  if (!aradIsAdmin()) return;
  if (!confirm("این نمره حذف شود؟")) return;

  const db = aradGetDB();

  db.grades.splice(index, 1);
  aradSaveDB(db);
  aradRenderAdmin();
}

function aradIsAdmin() {
  return sessionStorage.getItem("arad_admin_session") === "active";
}

aradCheckAdmin();
</script>

