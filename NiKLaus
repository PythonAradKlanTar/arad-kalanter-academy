          ${records.grades.map((g,i)=>`
            <div class="admin-student">
              <strong>${aradEscape(g.email)}</strong>
              <p>دوره: ${aradEscape(g.course)}</p>
              <h2>${g.value} از ۱۰۰</h2>
              <p>${aradEscape(g.description)}</p>
              <button class="danger"
                onclick="aradDeleteGrade(${i})">
                حذف نمره
              </button>
            </div>
          `).join("") || "هنوز نمره‌ای ثبت نشده است."}
        </div>
      </div>
    `;
  }

  if(tab==="courses"){

    content.innerHTML=`
      <div class="admin-box">
        <h2>📚 مدیریت دوره‌ها</h2>
        <p>دوره‌های موجود در آکادمی</p>
        <div id="aradCoursesList"></div>
      </div>
    `;

    let courses=[];

    try {
      const oldDB=JSON.parse(
        localStorage.getItem("aradAcademyDB")
      );
      courses=oldDB?.courses || [];
    } catch {}

    document.getElementById("aradCoursesList").innerHTML=
      courses.map(c=>`
        <div class="admin-student">
          <strong>${aradEscape(c.name)}</strong>
          <p>${aradEscape(c.description || "")}</p>
        </div>
      `).join("") || "دوره‌ای پیدا نشد.";
  }

  if(tab==="reports"){

    const grades=records.grades;
    const average=grades.length
      ? Math.round(grades.reduce((s,g)=>s+g.value,0)/grades.length)
      : 0;

    content.innerHTML=`
      <div class="admin-box">
        <h2>📊 گزارش عملکرد</h2>
