const btn=EXT.button;

function findAssignment(id) {
  return DB.assignments.find(x=>x.id===id);
}

function findStudent(id) {
  return DB.students.find(x=>x.id===id);
}

function allowedFile(file) {
  const allowed=[
    ".pdf",".zip",".png",".jpg",".jpeg",
    ".txt",".doc",".docx"
  ];

  const extension=file.name.toLowerCase().slice(
    file.name.lastIndexOf(".")
  );

  return allowed.includes(extension);
}

async function saveSubmission(assignment,student,file,note) {
  if(!EXT.enrolled(student,assignment.courseId)) {
    throw Error("برای ارسال باید در دوره ثبت‌نام کرده باشی.");
  }

  if(!allowedFile(file)) {
    throw Error("نوع فایل مجاز نیست.");
  }

  if(file.size>20*1024*1024) {
    throw Error("حداکثر حجم فایل ۲۰ مگابایت است.");
  }

  if(assignment.deadline &&
     new Date(assignment.deadline)<new Date()) {
    throw Error("مهلت ارسال این تکلیف تمام شده است.");
  }

  const submissionId=EXT.uid();

  await EXT.putAsset("submissions",{
    id:submissionId,
    name:file.name,
    type:file.type,
    size:file.size,
    blob:file,
    uploadedAt:new Date().toISOString()
  });

  const record={
    id:submissionId,
    assignmentId:assignment.id,
    courseId:assignment.courseId,
    studentId:student.id,
    fileName:file.name,
    fileSize:file.size,
    note:String(note||"").slice(0,3000),
    grade:null,
    feedback:"",
    status:"submitted",
    submittedAt:new Date().toISOString()
  };

  DB.submissions.push(record);

  EXT.save();

  return record;
}

async function downloadSubmission(submission) {
  const file=await EXT.getAsset(
    "submissions",
    submission.id
  );

  if(!file?.blob) {
    throw Error("فایل پیدا نشد.");
  }

  const url=URL.createObjectURL(file.blob);

  const link=h("a",{
    href:url,
    download:file.name||submission.fileName
  });

  document.body.append(link);
  link.click();
  link.remove();

  setTimeout(()=>URL.revokeObjectURL(url),3000);
}

