    placeholder:"توضیحات و قوانین آزمون"
  });

  const questionText=h("textarea",{
    placeholder:"متن سؤال"
  });

  const options=[
    h("input",{placeholder:"گزینه اول"}),
    h("input",{placeholder:"گزینه دوم"}),
    h("input",{placeholder:"گزینه سوم"}),
    h("input",{placeholder:"گزینه چهارم"})
  ];

  const answer=h("select");

  ["گزینه اول","گزینه دوم","گزینه سوم","گزینه چهارم"].forEach((x,i)=>{
    answer.append(h("option",{
      value:String(i),
      text:x
    }));
  });

  const points=h("input",{
