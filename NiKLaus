    const list = getClasses();

    list.push({
      id: "CLASS-" + Date.now(),
      title,
      date,
      link,
      description,
      createdAt: new Date().toISOString()
    });

    write(CLASS_KEY, list);
    event.target.reset();
    render();
    alert("کلاس با موفقیت ثبت شد.");
  });

  $("aradTeacherMaterialForm").addEventListener("submit", event => {
    event.preventDefault();
    if (!isTeacher()) return;

    const courseId = $("aradTeacherMaterialCourse").value;
    const course = courses().find(x => x.id === courseId);
    const title = $("aradTeacherMaterialTitle").value.trim();
    const description = $("aradTeacherMaterialDescription").value.trim();
    const link = $("aradTeacherMaterialLink").value.trim();

    if (!course || !title || !validURL(link)) {
      alert("دوره، عنوان یا لینک معتبر نیست.");
      return;
    }

    const list = getMaterials();

    list.push({
      id: "MAT-" + Date.now(),
      courseId,
      courseName: course.name,
      title,
      description,
      link,
      createdAt: new Date().toISOString()
    });

    write(MATERIAL_KEY, list);
    event.target.reset();
    render();
    alert("محتوای آموزشی منتشر شد.");
  });

  section.addEventListener("click", event => {
    if (!isTeacher()) return;

    const classButton = event.target.closest("[data-delete-class]");
    const materialButton = event.target.closest("[data-delete-material]");

    if (classButton) {
      if (!confirm("این کلاس حذف شود؟")) return;

      write(CLASS_KEY, getClasses().filter(
        x => x.id !== classButton.dataset.deleteClass
      ));

      render();
    }

    if (materialButton) {
      if (!confirm("این محتوا حذف شود؟")) return;

      write(MATERIAL_KEY, getMaterials().filter(
        x => x.id !== materialButton.dataset.deleteMaterial
      ));

      render();
    }
  });

  $("aradTeacherRefresh").addEventListener("click", render);

  window.aradTeacherRefresh = render;

  // گزینه منوی سایت
  const nav = $("navLinks");

  if (nav && !$("aradTeacherNav")) {
    const button = document.createElement("button");
    button.id = "aradTeacherNav";
    button.type = "button";
    button.textContent = "پنل استاد 👨‍🏫";

    button.addEventListener("click", () => {
      if (typeof window.showPage === "function") {
        window.showPage("aradTeacherPanel", button);
      } else {
        section.classList.add("active");
      }
      render();
    });

    nav.appendChild(button);
  }

  render();

  console.log("ARAD PART 16 READY");

})();
</script>

