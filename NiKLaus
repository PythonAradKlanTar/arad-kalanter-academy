    return sessionStorage.getItem("arad_admin_session") === "active";
  }

  function getCourses() {
    return typeof aradGetCourses === "function"
      ? aradGetCourses()
      : [];
  }

  function safe(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[c]);
