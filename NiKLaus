(() => {
"use strict";

const EXT=window.ARAD_ACADEMY_EXT;
if(!EXT)throw Error("ابتدا بخش ۴ را اجرا کن.");

const DB=EXT.DB;
DB.quizzes ||= [];
DB.quizAttempts ||= [];

const h=EXT.h;
const btn=EXT.button;

function allLessons(course) {
  return (course.chapters||[]).flatMap(ch =>
    (ch.lessons||[]).map(l=>({...l,chapterName:ch.title}))
  );
}

function studentProgress(student,course) {
  const lessons=allLessons(course);

  if(!lessons.length)return 0;

  const done=lessons.filter(l=>
    student.progress?.[l.id]?.completed
  ).length;

  return Math.round(done/lessons.length*100);
}

function renderProgress(parent) {
  const owner=EXT.owner();
  const student=EXT.student();

  parent.append(h("h2",{
    text:"گزارش پیشرفت آموزشی"
  }));

  if(!owner&&!student) {
    parent.append(h("p",{
      text:"برای مشاهده پیشرفت وارد حساب دانشجویی شو."
    }));
    return;
  }

  const students=owner?DB.students:[student];

  students.forEach(s=>{
    const box=h("section",{className:"card"});

    box.append(h("h3",{text:s.name}));

    DB.courses.forEach(course=>{
      const enrolled=EXT.enrolled(s,course.id);

      if(!enrolled)return;

      const percent=studentProgress(s,course);
      const lessons=allLessons(course);

      const completed=lessons.filter(
        l=>s.progress?.[l.id]?.completed
      ).length;

      const courseBox=h("div",{className:"item"});

      courseBox.append(
        h("strong",{text:course.title}),
        h("p",{text:`پیشرفت: ${percent}%`})
      );

      const bar=h("div",{
        style:"height:10px;border-radius:20px;background:#2a3854;overflow:hidden"
      });

      bar.append(h("div",{
        style:`width:${percent}%;height:100%;background:linear-gradient(90deg,#665cde,#47cbef)`
      }));

      courseBox.append(
        bar,
        h("p",{
          className:"muted",
          text:`${completed} جلسه از ${lessons.length} جلسه تکمیل شده`
        })
      );

      lessons.forEach(lesson=>{
        const progress=s.progress?.[lesson.id];

        courseBox.append(h("p",{
          className:progress?.completed?"success":"muted",
          text:
            (progress?.completed?"✓ ":"○ ")+
            lesson.title+
            (progress?.secondsWatched
              ?" — "+progress.secondsWatched+" ثانیه تماشا"
              :"")
        }));
      });

      box.append(courseBox);
    });

    parent.append(box);
  });
}

function renderQuizManager(parent) {
  const box=h("section",{className:"card"});

  box.append(h("h2",{text:"ساخت آزمون جدید"}));

  const courseSelect=h("select");

  DB.courses.forEach(course=>{
