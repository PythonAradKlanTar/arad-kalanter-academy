(async () => {
"use strict";

const EXT = window.ARAD_ACADEMY_EXT;
if (!EXT) throw Error("ابتدا بخش ۴ را اجرا کن.");

const DB = EXT.DB;
const uid = EXT.uid;

function getLesson(id) {
  for (const course of DB.courses) {
    for (const chapter of course.chapters || []) {
      const lesson = chapter.lessons.find(x=>x.id===id);
      if (lesson) return {course,chapter,lesson};
    }
  }
  return null;
}

function allVideoLessons() {
  return DB.courses.flatMap(course =>
    (course.chapters||[]).flatMap(chapter =>
      (chapter.lessons||[]).map(lesson=>({
        course,chapter,lesson
      }))
    )
  );
}

function playerPermission(item) {
  if (EXT.owner()) return true;

  const student = EXT.student();
  if (!student) return false;

  return item.lesson.free ||
    EXT.enrolled(student,item.course.id);
}

function displaySize(size) {
  return (size/1024/1024).toFixed(2)+" MB";
}

async function uploadVideo(lessonId,file) {
  if (!EXT.owner()) throw Error("فقط مالک آکادمی مجاز است.");

  const item = getLesson(lessonId);
  if (!item) throw Error("جلسه پیدا نشد.");

  const allowed = [
    ".mp4",".webm",".mov",".ogg",".m4v"
  ];

  const extension = file.name.toLowerCase().slice(
    file.name.lastIndexOf(".")
  );

  if (!allowed.includes(extension)) {
    throw Error("فرمت ویدئو پشتیبانی نمی‌شود.");
  }

  if (file.size > 512*1024*1024) {
    throw Error("حداکثر حجم آزمایشی هر ویدئو ۵۱۲ مگابایت است.");
  }

  await EXT.putAsset("videos",{
    id:lessonId,
    name:file.name,
    type:file.type || "video/mp4",
    size:file.size,
    blob:file,
    uploadedAt:new Date().toISOString()
  });

  item.lesson.videoAssetId = lessonId;
  item.lesson.videoFileName = file.name;
  item.lesson.videoSize = file.size;
  item.lesson.videoUrl = "";

  EXT.save();

  return true;
}

async function removeVideo(lessonId) {
  if (!EXT.owner()) throw Error("دسترسی مالک لازم است.");

  const item = getLesson(lessonId);
  if (!item) return;

  await EXT.deleteAsset("videos",lessonId);

  delete item.lesson.videoAssetId;
  delete item.lesson.videoFileName;
  delete item.lesson.videoSize;

  item.lesson.videoUrl = "";

  EXT.save();
}

EXT.openLesson = async function(course,chapter,lesson) {
  const item = {course,chapter,lesson};

  if (!playerPermission(item)) {
    return alert("برای مشاهده این جلسه باید در دوره ثبت‌نام کنی.");
  }

  let mediaURL = "";
  let revokeURL = false;

  if (lesson.videoAssetId) {
    const record = await EXT.getAsset(
      "videos",
      lesson.videoAssetId
    );

    if (!record?.blob) {
      return alert("فایل ویدئو پیدا نشد.");
    }

    mediaURL = URL.createObjectURL(record.blob);
    revokeURL = true;
  } else if (lesson.videoUrl) {
    try {
      const parsed = new URL(lesson.videoUrl);

      if (!["https:","http:"].includes(parsed.protocol)) {
        throw Error();
      }

      mediaURL = parsed.href;
    } catch {
      return alert("لینک ویدئو معتبر نیست.");
    }
  } else {
    return alert("برای این جلسه هنوز ویدئویی ثبت نشده است.");
  }

  const student = EXT.student();

  const overlay = EXT.h("div",{
    id:"arad-video-player-modal",
    style:[
      "position:fixed",
      "inset:0",
      "z-index:2147483647",
      "background:#050914f5",
      "display:flex",
      "align-items:center",
      "justify-content:center",
      "padding:15px",
      "direction:rtl"
    ].join(";")
  });

  const box = EXT.h("div",{
    style:[
      "width:min(950px,100%)",
      "background:#141f35",
      "border:1px solid #655ddd",
      "border-radius:16px",
      "padding:15px",
      "color:white"
    ].join(";")
  });

  const header = EXT.h("div",{
    style:"display:flex;justify-content:space-between;align-items:center;gap:8px"
  });

  header.append(
    EXT.h("strong",{text:lesson.title}),
    EXT.button("بستن",() => close(),"danger")
  );

  const video = EXT.h("video",{
    controls:"",
    playsinline:"",
    preload:"metadata",
    style:"width:100%;max-height:65vh;background:black;border-radius:10px;margin-top:12px"
  });

  video.src = mediaURL;

  const saved = student?.progress?.[lesson.id] || {};
  const resume = Number(saved.secondsWatched||0);

  video.addEventListener("loadedmetadata",() => {
    if (resume > 3 && resume < video.duration-5) {
      video.currentTime = resume;
    }
  });

  const info = EXT.h("p",{
    style:"color:#aebbd5"
  });

  let lastSave = 0;

  function saveWatch(force=false) {
    if (!student) return;

    const now = Date.now();

    if (!force && now-lastSave<15000) return;

    lastSave = now;

    student.progress ||= {};

    student.progress[lesson.id] = {
      ...(student.progress[lesson.id]||{}),
      secondsWatched:Math.floor(video.currentTime||0),
      completed:Boolean(
        student.progress[lesson.id]?.completed
      ),
      updatedAt:new Date().toISOString()
    };

    EXT.save();

    info.textContent =
      "زمان ذخیره‌شده: "+
      Math.floor(video.currentTime||0)+" ثانیه";
  }

  video.addEventListener("timeupdate",() => {
    saveWatch(false);
  });

  video.addEventListener("pause",() => saveWatch(true));

  video.addEventListener("ended",() => {
    if (student) {
      student.progress ||= {};

      student.progress[lesson.id] = {
        secondsWatched:Math.floor(video.duration||0),
        completed:true,
        updatedAt:new Date().toISOString()
      };

      EXT.save();
      info.textContent="این جلسه تکمیل شد.";
    }
  });

  const close = () => {
    try {
      saveWatch(true);
      video.pause();
      video.removeAttribute("src");
      video.load();

      if (revokeURL) URL.revokeObjectURL(mediaURL);

      overlay.remove();
    } catch(e) {
      console.error(e);
      overlay.remove();
    }
  };

  const note = EXT.h("p",{
    text:"آموزش ویدئویی — ARAD KALANTER ACADEMY",
    style:"color:#b4c1db"
  });

  box.append(header,note,video,info);
  overlay.append(box);

  overlay.addEventListener("click",event=>{
    if (event.target===overlay) close();
  });

  document.body.append(overlay);

  video.play().catch(()=>{});
};

