      : "<p>هنوز پروژه‌ای ارسال نکرده‌ای.</p>";
  }

  /* نمایش پنل مدیر */
  function renderAdminAssignments() {
    const container = $("aradAllAssignments");
    const message = $("aradAdminAssignmentMessage");

    if (!isAdmin()) {
      container.innerHTML = "";
      message.textContent =
        "برای بررسی پروژه‌ها ابتدا از پنل مدیریت وارد شو.";
      return;
    }

    message.textContent =
      "تمام پروژه‌های ارسال‌شده توسط دانش‌آموزان.";

    const submissions = getData().submissions;

    container.innerHTML = submissions.length
      ? submissions.map(item => `
          <div class="assignment-item">

            <h3>${escapeHTML(item.title)}</h3>

            <p>دانش‌آموز: ${escapeHTML(item.studentName)}</p>
            <p>ایمیل: ${escapeHTML(item.studentEmail)}</p>
            <p>دوره: ${escapeHTML(item.courseName)}</p>
