        ></textarea>

        <button type="submit">
          🚀 ارسال پروژه
        </button>

      </form>

      <p class="assignment-note">
        برای ارسال فایل‌های حجیم، در نسخه بعدی فضای آپلود
        اختصاصی اضافه می‌کنیم.
      </p>
    </div>

    <div class="assignment-box">
      <h2>📚 پروژه‌های ارسال‌شده من</h2>
      <div id="aradMyAssignments"></div>
    </div>

    <div class="assignment-box" id="aradAdminAssignments">
      <h2>👑 مدیریت تکالیف دانش‌آموزان</h2>

      <p class="assignment-note" id="aradAdminAssignmentMessage">
        برای مشاهده و بررسی پروژه‌ها باید مدیر وارد حساب شود.
      </p>

      <div id="aradAllAssignments"></div>
    </div>

    <p class="assignment-note">
      نسخه آزمایشی: اطلاعات در حافظه مرورگر ذخیره می‌شوند.
      برای استفاده چندکاربره و عمومی، اتصال بک‌اند و دیتابیس لازم است.
    </p>
  `;

  const target =
    document.getElementById("dashboardContent") ||
    document.querySelector("main") ||
    document.body;

  target.appendChild(section);

  const $ = id => document.getElementById(id);

  /* پر کردن فهرست دوره‌ها */
  function renderCourses() {
    const select = $("aradAssignmentCourse");
    const courses = getCourses();

    select.innerHTML =
      '<option value="">انتخاب دوره</option>' +
      courses.map(course => `
        <option value="${escapeHTML(course.id)}">
          ${escapeHTML(course.name)}
        </option>
      `).join("");
  }

  /* نمایش پروژه‌های دانش‌آموز */
  function renderMyAssignments() {
    const student = getStudent();
    const list = $("aradMyAssignments");

    if (!student) {
      list.innerHTML =
        "<p>برای ارسال و مشاهده پروژه‌ها وارد حساب دانش‌آموزی شو.</p>";
      return;
    }

    const submissions = getData().submissions.filter(
      item => item.studentId === student.id
    );

    list.innerHTML = submissions.length
      ? submissions.map(item => `
          <div class="assignment-item">

            <h3>${escapeHTML(item.title)}</h3>

            <p>دوره: ${escapeHTML(item.courseName)}</p>

            <p>${escapeHTML(item.description)}</p>

            <p>
              وضعیت:
              <span class="${item.status === "بررسی شد"
                ? "assignment-done"
                : "assignment-status"}">
                ${escapeHTML(item.status)}
              </span>
            </p>

            <p class="assignment-note">
              تاریخ ارسال:
              ${new Date(item.createdAt).toLocaleString("fa-IR")}
            </p>

            ${item.code ? `
              <details>
                <summary>مشاهده کد یا لینک پروژه</summary>
                <pre>${escapeHTML(item.code)}</pre>
              </details>
            ` : ""}

            ${item.status === "بررسی شد" ? `
              <div class="assignment-review">
                <h3>🏆 نتیجه بررسی</h3>
                <p>نمره: ${item.score ?? "ثبت نشده"} از ۱۰۰</p>
                <p>بازخورد مدیر:</p>
