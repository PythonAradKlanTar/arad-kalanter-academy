async function checkStorage() {
  const key="ARAD_TEMP_HEALTH_CHECK";

  try {
    localStorage.setItem(key,"ok");
    const result=localStorage.getItem(key)==="ok";
    localStorage.removeItem(key);
    return result;
  } catch {
    return false;
  }
}

async function checkIndexedDB() {
  try {
    const id=EXT.uid();

    await EXT.putAsset("videos",{
      id,
      name:"health-check.txt",
      type:"text/plain",
      size:2,
      blob:new Blob(["ok"],{type:"text/plain"})
    });

    const record=await EXT.getAsset("videos",id);

    await EXT.deleteAsset("videos",id);

    return Boolean(record?.blob);
  } catch(error) {
    console.error(error);
    return false;
  }
}

async function checkBackend() {
  try {
    const response=await fetch("/api/health",{
      method:"GET",
      credentials:"same-origin",
      cache:"no-store"
    });

    if(!response.ok)return false;

    const result=await response.json();
    return result.ok===true;
  } catch {
    return false;
  }
}

async function checkPWA() {
  try {
    const registration=
      "serviceWorker" in navigator
        ? await navigator.serviceWorker.getRegistration()
        : null;

    return Boolean(
      window.isSecureContext &&
      document.querySelector('link[rel="manifest"]') &&
      registration
    );
  } catch {
    return false;
  }
}

