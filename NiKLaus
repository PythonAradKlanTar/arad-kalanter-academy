function takeQuiz(parent,quiz,student) {
  parent.replaceChildren();

  const box=h("section",{className:"card"});

  box.append(
    h("h2",{text:quiz.title}),
    h("p",{text:quiz.description||""})
  );

  const form=h("div");
  const selectors=[];

  quiz.questions.forEach((question,index)=>{
    const group=h("div",{className:"item"});

    group.append(
      h("h3",{text:`سؤال ${index+1}`}),
      h("p",{text:question.text})
    );

    const name="arad-q-"+question.id;
    let selected=null;

    question.options.forEach((option,i)=>{
      const label=h("label",{
        style:"display:block;padding:9px"
      });

      const radio=h("input",{
        type:"radio",
        name,
        value:String(i),
        style:"width:auto"
      });

      radio.addEventListener("change",()=>{
        selected=i;
      });

      label.append(radio,document.createTextNode(option));
      group.append(label);
    });

    selectors.push(()=>selected);
    form.append(group);
  });

  form.append(btn("ثبت پاسخ‌ها",()=>{
    const answers=selectors.map(fn=>fn());

    if(answers.some(x=>x===null)) {
      return alert("به همه سؤال‌ها پاسخ بده.");
    }

    let score=0;
    let maximum=0;

    quiz.questions.forEach((question,index)=>{
      maximum+=question.points;

      if(answers[index]===question.correctIndex) {
        score+=question.points;
      }
    });

    const attempt={
      id:EXT.uid(),
      quizId:quiz.id,
      courseId:quiz.courseId,
      studentId:student.id,
      answers,
      score,
      maximum,
      percentage:Math.round(score/maximum*100),
      createdAt:new Date().toISOString()
    };

    DB.quizAttempts.push(attempt);
    EXT.save();

    parent.replaceChildren();

    parent.append(h("section",{className:"card"},[
      h("h2",{text:"نتیجه آزمون"}),
      h("div",{
        className:"number",
        text:score+" از "+maximum
      }),
      h("h3",{text:attempt.percentage+" درصد"}),
      h("p",{
        text:attempt.percentage>=50
          ?"آفرین! آزمون را با موفقیت گذراندی."
          :"نیاز به تمرین بیشتری داری."
      }),
      btn("بازگشت",()=>EXT.mount())
    ]));
  }));

  box.append(form);
  parent.append(box);
}

