            <h3>گفتگو</h3>

            ${(ticket.replies || []).map(reply => `
              <div class="support-reply">
                <strong>${safe(reply.author)}</strong>
                <p>${safe(reply.message)}</p>
              </div>
            `).join("")}

            <textarea
              data-reply-input="${safe(ticket.id)}"
              placeholder="پاسخ مدیر را وارد کن..."
            ></textarea>

            <button data-send-reply="${safe(ticket.id)}">
              📤 ارسال پاسخ
            </button>

            <button
              data-status="${safe(ticket.id)}"
              class="support-danger"
            >
              ${ticket.status === "بسته شده"
                ? "بازگشایی تیکت"
                : "بستن تیکت"}
            </button>

          </article>
        `).join("")
      : "<p>هنوز تیکتی ثبت نشده است.</p>";
  }

  function render() {
    $("aradSupportForm").hidden = !getUser();

    renderStudentTickets();
    renderAdminTickets();
  }

  // ثبت تیکت توسط دانش‌آموز
  $("aradSupportForm").addEventListener("submit", event => {
    event.preventDefault();

    const user = getUser();

    if (!user) {
      alert("ابتدا وارد حساب دانش‌آموزی شو.");
      return;
    }

    const subject = $("aradTicketSubject").value.trim();
    const category = $("aradTicketCategory").value;
    const message = $("aradTicketMessage").value.trim();

    if (!subject || !category || !message) {
      alert("لطفاً تمام اطلاعات را وارد کن.");
      return;
    }

    const data = getData();

    data.tickets.push({
      id: "ARAD-TICKET-" + Date.now(),
      userId: user.id,
      userName: user.name,
      userEmail: user.email,
      subject,
      category,
      message,
      status: "در انتظار بررسی",
      replies: [],
      createdAt: new Date().toISOString()
    });

    saveData(data);

    event.target.reset();
    render();

    alert("درخواست پشتیبانی ثبت شد. 🎉");
  });

  // پاسخ مدیر و تغییر وضعیت
  section.addEventListener("click", event => {
    const replyButton = event.target.closest("[data-send-reply]");
    const statusButton = event.target.closest("[data-status]");

    if (!replyButton && !statusButton) return;

    if (!isAdmin()) {
      alert("دسترسی مدیر لازم است.");
      return;
    }

    const id = replyButton
      ? replyButton.dataset.sendReply
      : statusButton.dataset.status;

    const data = getData();

    const ticket = data.tickets.find(
      item => item.id === id
    );

    if (!ticket) return;

    if (replyButton) {
