      item.append($("p", {text:note.text}));

      item.append(actionButton(
        "حذف یادداشت",
        () => {
          student.notes = student.notes.filter(
            n => n.id !== note.id
          );

          save();
          showDashboard();
        },
        "danger"
      ));

      container.append(item);
    });
  }

