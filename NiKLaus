window.aradAdminLogout=function(){
  sessionStorage.removeItem("arad_admin_session");

  document.getElementById("aradAdmin")
    .classList.remove("active");

  document.getElementById("aradAdminLogin")
    .classList.add("active");
};

window.aradAdminTab=function(tab){

  if(!adminIsOpen()) return;

  const content =
    document.getElementById("aradAdminContent");

  const records=getRecords();

  if(tab==="students"){

    let users=[];

    try {
      const oldDB=JSON.parse(
        localStorage.getItem("aradAcademyDB")
      );
      users=oldDB?.users || [];
    } catch {}

    content.innerHTML=`
      <div class="admin-box">
        <h2>👨‍🎓 مدیریت دانش‌آموزان</h2>
        <p>تعداد دانش‌آموزان: ${users.length}</p>
        ${users.map((u,i)=>`
