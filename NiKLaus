(async () => {
"use strict";

const EXT=window.ARAD_ACADEMY_EXT;
if(!EXT)throw Error("ابتدا بخش ۴ را اجرا کن.");

const DB=EXT.DB;
const h=EXT.h, btn=EXT.button;

function readBlob(blob) {
  return new Promise((resolve,reject)=>{
    const reader=new FileReader();
    reader.onload=()=>resolve(reader.result);
    reader.onerror=()=>reject(reader.error);
    reader.readAsDataURL(blob);
  });
}

function dataToBlob(data) {
  const comma=data.indexOf(",");
  const mimeMatch=data.slice(0,comma).match(/data:(.*?);base64/);

  const mime=mimeMatch?.[1]||"application/octet-stream";
  const binary=atob(data.slice(comma+1));
  const bytes=new Uint8Array(binary.length);

  for(let i=0;i<binary.length;i++) {
    bytes[i]=binary.charCodeAt(i);
  }

  return new Blob([bytes],{type:mime});
}

function getAll(storeName) {
  return new Promise(async(resolve,reject)=>{
    try {
      const database=await EXT.assetDB;
      const tx=database.transaction(storeName,"readonly");
      const request=tx.objectStore(storeName).getAll();

      request.onsuccess=()=>resolve(request.result);
      request.onerror=()=>reject(request.error);
    } catch(error) {
      reject(error);
    }
  });
}

async function exportAssets(storeName) {
  const records=await getAll(storeName);

  const output=[];

  for(const record of records) {
    const {blob,...metadata}=record;

    output.push({
      ...metadata,
      blobData:blob instanceof Blob
        ? await readBlob(blob)
        : null
    });
  }

  return output;
}

function replaceAssets(storeName,records) {
  return new Promise(async(resolve,reject)=>{
    try {
      const database=await EXT.assetDB;

      const tx=database.transaction(storeName,"readwrite");
      const store=tx.objectStore(storeName);

      store.clear();

      for(const record of records||[]) {
        const {blobData,...metadata}=record;

        store.put({
          ...metadata,
          blob:blobData?dataToBlob(blobData):null
        });
      }

      tx.oncomplete=()=>resolve(true);
      tx.onerror=()=>reject(tx.error);
      tx.onabort=()=>reject(tx.error||new Error("عملیات لغو شد."));
    } catch(error) {
      reject(error);
    }
  });
}

function downloadFile(content,name) {
  const blob=new Blob(
    [content],
    {type:"application/json;charset=utf-8"}
  );

  const url=URL.createObjectURL(blob);
  const link=h("a",{
    href:url,
    download:name
  });

  document.body.append(link);
  link.click();
  link.remove();

  setTimeout(()=>URL.revokeObjectURL(url),10000);
}

async function createFullBackup(progress=()=>{}) {
  if(!EXT.owner()) {
    throw Error("فقط مالک آکادمی مجاز به پشتیبان‌گیری کامل است.");
  }

  progress("در حال جمع‌آوری ویدئوها...");

  const videos=await exportAssets("videos");

  progress("در حال جمع‌آوری تکالیف...");

  const submissions=await exportAssets("submissions");

  progress("در حال ساخت فایل پشتیبان...");

  const snapshot={
    product:"ARAD KALANTER ACADEMY",
    formatVersion:1,
    createdAt:new Date().toISOString(),
    applicationData:JSON.parse(JSON.stringify(DB)),
    assets:{
      videos,
      submissions
    }
  };

  const json=JSON.stringify(snapshot);

  return {
    snapshot,
    json,
    bytes:new Blob([json]).size,
    videoCount:videos.length,
    submissionCount:submissions.length
  };
}

async function restoreFullBackup(file,progress=()=>{}) {
  if(!EXT.owner()) {
    throw Error("فقط مالک آکادمی مجاز به بازیابی است.");
  }

  if(file.size>1024*1024*1024) {
    throw Error("حجم فایل پشتیبان بیشتر از یک گیگابایت است.");
  }

  progress("در حال خواندن فایل...");

  const snapshot=JSON.parse(await file.text());

  if(
    snapshot.product!=="ARAD KALANTER ACADEMY"||
    snapshot.formatVersion!==1||
    !snapshot.applicationData||
    !Array.isArray(snapshot.applicationData.courses)||
    !Array.isArray(snapshot.applicationData.students)
  ) {
    throw Error("فایل پشتیبان معتبر نیست.");
  }

  if(!snapshot.assets) {
    snapshot.assets={videos:[],submissions:[]};
  }

  if(!Array.isArray(snapshot.assets.videos)||
     !Array.isArray(snapshot.assets.submissions)) {
    throw Error("ساختار فایل‌های ضمیمه معتبر نیست.");
  }

  if(!confirm(
    "تمام اطلاعات فعلی جایگزین شوند؟\n"+
    "این عملیات قابل بازگشت نیست."
  ))return false;

  progress("در حال بازیابی فایل‌های ویدئویی...");
  await replaceAssets(
    "videos",
    snapshot.assets.videos
  );

  progress("در حال بازیابی تکالیف...");
  await replaceAssets(
    "submissions",
    snapshot.assets.submissions
  );

  progress("در حال بازیابی اطلاعات آکادمی...");

  Object.keys(DB).forEach(key=>delete DB[key]);

  Object.assign(DB,snapshot.applicationData);

  DB.courses ||= [];
  DB.students ||= [];
  DB.messages ||= [];
  DB.coupons ||= [];
  DB.orders ||= [];
  DB.assignments ||= [];
  DB.submissions ||= [];
  DB.quizzes ||= [];
  DB.quizAttempts ||= [];
  DB.settings ||= {};
  DB.announcements ||= [];

  EXT.save();

  progress("بازیابی تکمیل شد.");

  return true;
}

function renderBackup(parent) {
  parent.append(h("h2",{
    text:"پشتیبان‌گیری کامل آکادمی"
  }));

  if(!EXT.owner()) {
    parent.append(h("p",{
      className:"warning",
      text:"برای دسترسی به این بخش باید با حساب مالک اصلی وارد شوی."
    }));
    return;
  }

  const box=h("section",{className:"card"});

  box.append(
    h("p",{
      text:"این نسخه شامل اطلاعات پایگاه داده محلی، دوره‌ها، حساب‌ها، آزمون‌ها، پیام‌ها، ویدئوها و تکالیف ذخیره‌شده در همین مرورگر است."
    })
  );

  const status=h("p",{
    className:"muted",
    text:"آماده پشتیبان‌گیری"
  });

  box.append(status);

  box.append(btn("ساخت و دانلود نسخه کامل",async()=>{
    try {
      status.textContent="شروع پشتیبان‌گیری...";

      const result=await createFullBackup(
        text=>status.textContent=text
      );

      const filename=
        "ARAD_FULL_BACKUP_"+
        new Date().toISOString().replace(/[:.]/g,"-")+
        ".json";

      downloadFile(result.json,filename);

      status.textContent=
        `پشتیبان آماده شد؛ حجم ${(result.bytes/1024/1024).toFixed(2)} مگابایت، `+
        `${result.videoCount} ویدئو و ${result.submissionCount} تکلیف.`;
    } catch(error) {
      status.textContent="خطا: "+error.message;
      console.error(error);
    }
