"use strict";

const EXT=window.ARAD_ACADEMY_EXT;
if(!EXT)throw Error("ابتدا بخش ۴ را اجرا کن.");

const DB=EXT.DB;
DB.messages ||= [];
DB.coupons ||= [];
DB.announcements ||= [];

const h=EXT.h, btn=EXT.button;

EXT.validCoupon=function(code,coursePrice) {
  const coupon=DB.coupons.find(c=>
    c.code===String(code).trim().toUpperCase() &&
    c.active
  );

  if(!coupon)throw Error("کد تخفیف معتبر نیست.");

  if(coupon.expiresAt &&
     new Date(coupon.expiresAt)<new Date()) {
    throw Error("مهلت کد تخفیف تمام شده است.");
  }

  if(coupon.maxUses>0 && coupon.uses>=coupon.maxUses) {
    throw Error("ظرفیت استفاده از کد تکمیل شده است.");
  }

  const price=Math.max(0,Number(coursePrice)||0);
  const discount=Math.round(price*coupon.percent/100);

  return {
    coupon,
    discount,
    finalPrice:Math.max(0,price-discount)
  };
};

function managerMessages(parent) {
  const box=h("section",{className:"card"});
  box.append(h("h2",{text:"ارسال پیام و اطلاعیه"}));

  const title=h("input",{placeholder:"عنوان پیام"});
  const body=h("textarea",{placeholder:"متن اطلاعیه"});
  const kind=h("select");

  kind.append(
    h("option",{value:"announcement",text:"اطلاعیه عمومی"}),
    h("option",{value:"message",text:"پیام به همه دانشجویان"})
  );

  box.append(title,body,kind);

  box.append(btn("ارسال برای دانشجویان",()=>{
    if(!title.value.trim()||!body.value.trim()) {
      return alert("عنوان و متن پیام الزامی است.");
    }

    const item={
      id:EXT.uid(),
      title:title.value.trim(),
      body:body.value.trim(),
      type:kind.value,
      createdAt:new Date().toISOString(),
      createdBy:"owner",
      readBy:[]
    };

    DB.messages.unshift(item);

    if(kind.value==="announcement") {
      DB.announcements.unshift(item);
    }

    EXT.save();
    EXT.mount();
  }));

  parent.append(box);

  parent.append(h("h2",{text:"پیام‌های ارسال‌شده"}));

  DB.messages.forEach(item=>{
    const box=h("div",{className:"item"});

    box.append(
      h("strong",{text:item.title}),
      h("p",{text:item.body}),
      h("p",{
        className:"muted",
        text:item.type==="announcement"?"اطلاعیه":"پیام عمومی"
      }),
      btn("حذف پیام",()=>{
        if(!confirm("پیام حذف شود؟"))return;

        DB.messages=DB.messages.filter(m=>m.id!==item.id);
        DB.announcements=DB.announcements.filter(m=>m.id!==item.id);

        EXT.save();
        EXT.mount();
      },"danger")
    );

    parent.append(box);
  });
}

function studentMessages(parent) {
  const student=EXT.student();

  if(!student) {
    parent.append(h("p",{text:"ابتدا وارد حساب دانشجویی شو."}));
    return;
  }

  parent.append(h("h2",{text:"صندوق پیام‌های من"}));

  const items=DB.messages.slice().reverse();

  if(!items.length) {
    parent.append(h("p",{className:"muted",text:"پیامی نداری."}));
  }

  items.forEach(item=>{
    item.readBy ||= [];
    const read=item.readBy.includes(student.id);

    const box=h("section",{className:"card"});

    box.append(
      h("strong",{text:item.title}),
      h("p",{text:item.body}),
      h("small",{
        text:new Date(item.createdAt).toLocaleString("fa-IR")
      }),
      h("p",{
        className:read?"success":"warning",
        text:read?"خوانده‌شده":"خوانده‌نشده"
      })
    );

    if(!read) {
      box.append(btn("علامت‌گذاری به‌عنوان خوانده‌شده",()=>{
        item.readBy.push(student.id);
        EXT.save();
        EXT.mount();
      }));
    }

    parent.append(box);
  });
}

function couponManager(parent) {
  if(!EXT.owner())return;

  parent.append(h("h2",{text:"مدیریت کد تخفیف"}));

  const box=h("section",{className:"card"});

  const code=h("input",{placeholder:"مثلاً ARAD20"});
  const percent=h("input",{type:"number",placeholder:"درصد تخفیف"});
  const max=h("input",{type:"number",placeholder:"حداکثر استفاده؛ صفر یعنی نامحدود"});
  const expiry=h("input",{type:"datetime-local"});

  box.append(
    code,percent,max,
    h("label",{text:"تاریخ انقضا"}),
    expiry
  );

  box.append(btn("ساخت کد تخفیف",()=>{
    const normalized=code.value.trim().toUpperCase();
    const p=Number(percent.value);
    const uses=Number(max.value)||0;

    if(!/^[A-Z0-9_-]{3,30}$/.test(normalized)) {
      return alert("کد باید ۳ تا ۳۰ حرف، عدد، خط تیره یا زیرخط باشد.");
    }

    if(!Number.isFinite(p)||p<1||p>90) {
      return alert("درصد تخفیف باید بین ۱ تا ۹۰ باشد.");
    }

    if(DB.coupons.some(c=>c.code===normalized)) {
      return alert("این کد قبلاً ثبت شده است.");
    }

    DB.coupons.push({
      id:EXT.uid(),
      code:normalized,
      percent:p,
      maxUses:Math.max(0,uses),
      uses:0,
      expiresAt:expiry.value||null,
      active:true,
      createdAt:new Date().toISOString()
    });

    EXT.save();
    EXT.mount();
  }));

  parent.append(box);

  DB.coupons.forEach(coupon=>{
    const item=h("div",{className:"item"});

    item.append(
      h("strong",{text:coupon.code}),
      h("p",{text:`تخفیف: ${coupon.percent}%`}),
      h("p",{text:`استفاده: ${coupon.uses}/${coupon.maxUses||"نامحدود"}`}),
      h("p",{
        text:coupon.active?"فعال":"غیرفعال",
        className:coupon.active?"success":"warning"
      }),
      btn(coupon.active?"غیرفعال کردن":"فعال کردن",()=>{
        coupon.active=!coupon.active;
        EXT.save();
        EXT.mount();
      },"secondary"),
      btn("حذف کد",()=>{
        if(!confirm("کد حذف شود؟"))return;
        DB.coupons=DB.coupons.filter(c=>c.id!==coupon.id);
        EXT.save();
        EXT.mount();
      },"danger")
    );

    parent.append(item);
  });
}

function renderCommunication(parent) {
  if(EXT.owner())managerMessages(parent);
  else studentMessages(parent);

  if(EXT.owner())couponManager(parent);
}

EXT.addTab("communication","پیام و تخفیف",renderCommunication);
EXT.open();

window.ARAD_COMMUNICATION_V8={
  validCoupon:EXT.validCoupon,
  DB
};

console.log("Part 8 installed.");
})();

(() => {
"use strict";

const EXT=window.ARAD_ACADEMY_EXT;
if(!EXT)throw Error("ابتدا بخش ۴ را اجرا کن.");

const DB=EXT.DB;
DB.orders ||= [];
EXT.cart ||= [];

const h=EXT.h, btn=EXT.button;

function studentOrders(student) {
  return DB.orders.filter(o=>o.studentId===student.id);
}

function courseById(id) {
  return DB.courses.find(c=>c.id===id);
}

function priceOf(course) {
  return Math.max(0,Number(course.price)||0);
}

function money(value) {
  return Number(value||0).toLocaleString("fa-IR")+" ریال";
}

function makeOrder(student,courseIds,couponCode="") {
  const courses=courseIds.map(courseById);

  if(!courses.length||courses.some(c=>!c||!c.published)) {
    throw Error("یکی از دوره‌های انتخابی موجود یا منتشرشده نیست.");
  }

  const unique=[...new Set(courseIds)];
  if(unique.length!==courseIds.length) {
    throw Error("دوره تکراری در سبد خرید وجود دارد.");
  }

  const subtotal=courses.reduce((s,c)=>s+priceOf(c),0);

  let discount=0;
  let coupon=null;

  if(couponCode.trim()) {
    const result=EXT.validCoupon(couponCode,subtotal);
    discount=result.discount;
    coupon=result.coupon;
  }

  const order={
    id:EXT.uid(),
    invoice:"ARAD-"+Date.now().toString(36).toUpperCase(),
    studentId:student.id,
    studentEmail:student.email,
    items:courses.map(c=>({
      courseId:c.id,
      title:c.title,
      price:priceOf(c)
    })),
    couponId:coupon?.id||null,
    couponCode:coupon?.code||"",
    subtotal,
    discount,
    total:Math.max(0,subtotal-discount),
    currency:"IRR",
    status:"pending",
    paymentProvider:null,
    paymentReference:null,
    createdAt:new Date().toISOString()
  };

  DB.orders.unshift(order);
  EXT.save();

  return order;
}

function renderStore(parent) {
  const student=EXT.student();

  parent.append(h("h2",{text:"فروشگاه دوره‌های آکادمی"}));

  if(!student) {
    parent.append(h("p",{
      className:"warning",
      text:"برای سفارش دوره باید وارد حساب دانشجویی شوی."
    }));
    return;
  }

  const cart=EXT.cart;
  const box=h("section",{className:"card"});

  box.append(h("h3",{text:"دوره‌های قابل خرید"}));

  DB.courses.filter(c=>c.published).forEach(course=>{
    const item=h("div",{className:"item"});

    item.append(
      h("strong",{text:course.title}),
      h("p",{text:course.description||""}),
      h("p",{text:priceOf(course)===0?"رایگان":money(course.price)})
    );

    const enrolled=EXT.enrolled(student,course.id);

    item.append(btn(
      enrolled?"ثبت‌نام شده‌ای":
        priceOf(course)===0?"ثبت‌نام رایگان":"افزودن به سبد",
      ()=>{
        try {
          if(enrolled)return alert("قبلاً در دوره ثبت‌نام کرده‌ای.");

          if(priceOf(course)===0) {
            EXT.addEnrollment(student,course);
            alert("ثبت‌نام رایگان انجام شد.");
            EXT.mount();
            return;
          }

          if(!cart.includes(course.id))cart.push(course.id);

          alert("دوره به سبد خرید اضافه شد.");
          EXT.mount();
        } catch(error) {
          alert(error.message);
        }
      },
      enrolled?"secondary":""
    ));

    box.append(item);
  });

  parent.append(box);

  const checkout=h("section",{className:"card"});
  checkout.append(h("h3",{text:"سبد خرید"}));

  const coupon=h("input",{
    placeholder:"کد تخفیف اختیاری"
  });

  checkout.append(coupon);

  cart.forEach(id=>{
    const course=courseById(id);
    if(!course)return;

    checkout.append(h("div",{
      className:"item",
      text:course.title+" — "+money(priceOf(course))
    }));

    checkout.append(btn("حذف از سبد",()=>{
      EXT.cart=EXT.cart.filter(x=>x!==id);
      EXT.mount();
    },"danger"));
  });

  const total=cart.reduce((sum,id)=>{
    const c=courseById(id);
    return sum+(c?priceOf(c):0);
  },0);

  checkout.append(h("p",{
    text:"جمع اولیه: "+money(total)
  }));

  checkout.append(btn("ثبت سفارش و صدور فاکتور",()=>{
    try {
      if(!cart.length)throw Error("سبد خرید خالی است.");

      const order=makeOrder(
        student,
        [...cart],
        coupon.value
      );

      EXT.cart=[];
      EXT.mount();

      alert(
        "فاکتور ساخته شد: "+order.invoice+
        "\nمبلغ: "+money(order.total)+
        "\nوضعیت: در انتظار پرداخت"
      );
    } catch(error) {
      alert(error.message);
    }
  }));

  parent.append(checkout);

  const orders=studentOrders(student);
  const history=h("section",{className:"card"});

  history.append(h("h3",{text:"سفارش‌های من"}));

  orders.forEach(order=>{
    history.append(h("div",{className:"item"},[
      h("strong",{text:order.invoice}),
      h("p",{text:"مبلغ: "+money(order.total)}),
      h("p",{text:"وضعیت: "+order.status}),
      h("p",{text:"تاریخ: "+new Date(order.createdAt).toLocaleString("fa-IR")})
    ]));
  });

  parent.append(history);
}

function renderFinancialReport(parent) {
  parent.append(h("h2",{text:"گزارش مالی و سفارش‌ها"}));

  const total=DB.orders.reduce((s,o)=>s+o.total,0);
  const pending=DB.orders.filter(o=>o.status==="pending");
  const paid=DB.orders.filter(o=>o.status==="paid");
  const cancelled=DB.orders.filter(o=>o.status==="cancelled");

  const stats=h("div",{className:"grid"});

  [
    ["کل سفارش‌ها",DB.orders.length],
    ["مجموع سفارش‌ها",money(total)],
    ["در انتظار پرداخت",pending.length],
    ["پرداخت‌شده",paid.length],
    ["لغوشده",cancelled.length]
  ].forEach(([label,value])=>{
    const box=h("div",{className:"card"});
    box.append(
      h("p",{text:label,className:"muted"}),
      h("strong",{text:String(value)})
    );
    stats.append(box);
  });

  parent.append(stats);

  DB.orders.forEach(order=>{
    const box=h("section",{className:"card"});

    box.append(
      h("strong",{text:order.invoice}),
      h("p",{text:"دانشجو: "+order.studentEmail}),
      h("p",{text:"مبلغ: "+money(order.total)}),
      h("p",{text:"وضعیت: "+order.status}),
      h("p",{text:"تخفیف: "+money(order.discount)})
    );

    order.items.forEach(item=>{
      box.append(h("p",{
        className:"muted",
        text:item.title+" — "+money(item.price)
      }));
    });

    if(order.status==="pending") {
      box.append(btn("لغو سفارش",()=>{
        if(!confirm("سفارش لغو شود؟"))return;
        order.status="cancelled";
        order.cancelledAt=new Date().toISOString();
        EXT.save();
        EXT.mount();
      },"danger"));
    }

    parent.append(box);
  });

  parent.append(h("p",{
    className:"warning",
    text:"درگاه پرداخت واقعی متصل نیست؛ هیچ سفارش را پرداخت‌شده تلقی نکن."
  }));
}

function renderCommerce(parent) {
  if(EXT.owner())renderFinancialReport(parent);
  else renderStore(parent);
}

EXT.addTab("store","فروشگاه",renderCommerce);
EXT.open();

window.ARAD_COMMERCE_V9={
  makeOrder,
  renderFinancialReport,
